+        << "action=" << static_cast<int>(action);
+  }
+  // Un-attributed internal requests (native user flows) keep working.
+  for (BrowserCliPresentationAction action : kAllActions) {
+    EXPECT_TRUE(Allow(ForegroundOrigin::kInternal, action, 70))
+        << "action=" << static_cast<int>(action);
+  }
+  // The lease never lets another automation origin ride along.
+  const ForegroundOrigin other_automation[] = {
+      ForegroundOrigin::kExtension, ForegroundOrigin::kWebPage,
+      ForegroundOrigin::kSessionRestore};
+  for (ForegroundOrigin origin : other_automation) {
+    for (BrowserCliPresentationAction action : kAllActions) {
+      EXPECT_FALSE(Allow(origin, action, 70))
+          << "origin=" << static_cast<int>(origin)
+          << " action=" << static_cast<int>(action);
+    }
+  }
+}
+
+TEST_F(BrowserCliPresentationPolicyTest,
+       AssistLeaseKeepsOtherWindowsInBackground) {
+  EnableManagedModeAt(TestNow());
+  ASSERT_EQ(RequestAssist(80), ForegroundAssistRequestResult::kGranted);
+
+  for (BrowserCliPresentationAction action : kAllActions) {
+    // The proven non-presenting bounds change stays allowed for every origin
+    // on an unleased window (unchanged background behavior); every other
+    // action is denied, for internal and agent alike.
+    const bool expected_allow =
+        action == BrowserCliPresentationAction::kSetBounds;
+    EXPECT_EQ(Allow(ForegroundOrigin::kInternal, action, 81), expected_allow)
+        << "action=" << static_cast<int>(action);
+    EXPECT_EQ(Allow(ForegroundOrigin::kAgentAssist, action, 81), expected_allow)
+        << "action=" << static_cast<int>(action);
+  }
+  EXPECT_FALSE(policy()->IsForegroundAssistLeased(81));
+  EXPECT_EQ(policy()->window_state_for_testing(81),
+            BrowserCliPresentationState::kBackground);
+}
+
+TEST_F(BrowserCliPresentationPolicyTest, AssistLeaseExpiresLazily) {
+  EnableManagedModeAt(TestNow());
+  ASSERT_EQ(RequestAssist(90), ForegroundAssistRequestResult::kGranted);
+
+  AdvanceClock(kDefaultForegroundAssistLeaseTtl - base::Milliseconds(1));
+  EXPECT_TRUE(policy()->IsForegroundAssistLeased(90));
+
+  // At the deadline the lease is expired: it reports unleased, the window is
+  // back to background and the agent can no longer present it.
+  AdvanceClock(base::Milliseconds(1));
+  EXPECT_FALSE(policy()->IsForegroundAssistLeased(90));
+  EXPECT_EQ(policy()->active_foreground_assist_lease_count_for_testing(), 0u);
+  EXPECT_EQ(policy()->window_state_for_testing(90),
+            BrowserCliPresentationState::kBackground);
+  EXPECT_FALSE(Allow(ForegroundOrigin::kAgentAssist,
+                     BrowserCliPresentationAction::kShowAndActivate, 90));
+
+  // The single slot is free again.
+  EXPECT_EQ(RequestAssist(91), ForegroundAssistRequestResult::kGranted);
+}
+
+TEST_F(BrowserCliPresentationPolicyTest,
+       AssistExplicitExpirySweepIsIdempotent) {
+  EnableManagedModeAt(TestNow());
+  ASSERT_EQ(RequestAssist(95), ForegroundAssistRequestResult::kGranted);
+
+  EXPECT_EQ(policy()->ReleaseExpiredForegroundAssistLeases(), 0u);
+  AdvanceClock(kDefaultForegroundAssistLeaseTtl);
+  EXPECT_EQ(policy()->ReleaseExpiredForegroundAssistLeases(), 1u);
+  EXPECT_EQ(policy()->ReleaseExpiredForegroundAssistLeases(), 0u);
+  EXPECT_FALSE(policy()->IsForegroundAssistLeased(95));
+  EXPECT_EQ(policy()->active_foreground_assist_lease_count_for_testing(), 0u);
+}
+
+TEST_F(BrowserCliPresentationPolicyTest,
+       AssistAgentReleaseRestoresBackgroundDenial) {
+  EnableManagedModeAt(TestNow());
+  ASSERT_EQ(RequestAssist(100), ForegroundAssistRequestResult::kGranted);
+
+  // Releasing an unrelated id is a no-op.
+  policy()->ReleaseForegroundAssist(
+      999, ForegroundAssistReleaseReason::kAgentRelease);
+  EXPECT_TRUE(policy()->IsForegroundAssistLeased(100));
+
+  policy()->ReleaseForegroundAssist(
+      100, ForegroundAssistReleaseReason::kAgentRelease);
+  EXPECT_FALSE(policy()->IsForegroundAssistLeased(100));
+  EXPECT_EQ(policy()->active_foreground_assist_lease_count_for_testing(), 0u);
+  EXPECT_FALSE(Allow(ForegroundOrigin::kAgentAssist,
+                     BrowserCliPresentationAction::kShowAndActivate, 100));
+
+  // The window can be leased again afterwards.
+  EXPECT_EQ(RequestAssist(100), ForegroundAssistRequestResult::kGranted);
+}
+
+TEST_F(BrowserCliPresentationPolicyTest,
+       AssistUserTakeoverReleasesLeaseThenGrantsHuman) {
+  EnableManagedModeAt(TestNow());
+  ASSERT_EQ(RequestAssist(110), ForegroundAssistRequestResult::kGranted);
+
+  // A user takeover on the leased window wins: the lease is released first,
+  // then per-window HUMAN ownership is granted.
+  EXPECT_TRUE(Allow(ForegroundOrigin::kUserExplicit,
+                    BrowserCliPresentationAction::kShowAndActivate, 110));
+  EXPECT_FALSE(policy()->IsForegroundAssistLeased(110));
+  EXPECT_TRUE(policy()->IsUserExplicitOwned(110));
+  EXPECT_EQ(policy()->window_state_for_testing(110),
+            BrowserCliPresentationState::kHuman);
+  EXPECT_EQ(policy()->state_for_testing(),
+            BrowserCliPresentationState::kBackground);
+
+  // Automation stays denied on the HUMAN-owned window, and a late assist
+  // release can no longer touch it.
+  EXPECT_FALSE(Allow(ForegroundOrigin::kAgentAssist,
+                     BrowserCliPresentationAction::kShowAndActivate, 110));
+  policy()->ReleaseForegroundAssist(
+      110, ForegroundAssistReleaseReason::kAgentRelease);
+  EXPECT_TRUE(policy()->IsUserExplicitOwned(110));
+  EXPECT_FALSE(policy()->IsForegroundAssistLeased(110));
+  EXPECT_TRUE(AllowInternal(110));
+}
