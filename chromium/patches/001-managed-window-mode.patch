+// Browser CLI: presents |browser|'s native window because the user explicitly
+// asked for it (Dock / Launchpad / app reopen). Managed-mode detection and the
+// presentation are both routed through NativeWidgetMacNSWindowHost (inside the
+// ui/views component), so this file never reaches the presentation policy
+// singleton directly and the process keeps exactly one policy state. The
+// presentation is attributed USER_EXPLICIT and grants per-window HUMAN
+// ownership to that one window; no other managed window is unsuppressed, so an
+// agent/extension/web page/session restore can never ride along on the user's
+// action. Returns whether the presentation was applied. In stock (unmanaged)
+// Chromium this is a no-op because the window already showed itself and the
+// check below is false.
+bool PresentBrowserWindowUserExplicitly(BrowserWindowInterface* browser) {
+  if (!views::NativeWidgetMacNSWindowHost::
+          IsBrowserCliManagedPresentationEnabled()) {
+    return false;
+  }
+  if (!browser || !browser->GetWindow()) {
+    return false;
+  }
+  views::NativeWidgetMacNSWindowHost* host =
+      views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+          browser->GetWindow()->GetNativeWindow());
+  if (!host) {
+    return false;
+  }
+  return host->PresentForUserExplicitAction();
+}
+
+// Browser CLI: presents one existing browser window for an explicit user
+// reopen (Dock / Launchpad / app reopen) while managed background presentation
+// keeps every window hidden. Returns true when an existing window was
+// presented; false means the caller should fall back to creating a new window
+// (no reusable window exists, or managed mode is disabled).
+bool PresentExistingBrowserWindowForUserExplicitReopen() {
+  if (!views::NativeWidgetMacNSWindowHost::
+          IsBrowserCliManagedPresentationEnabled()) {
+    return false;
+  }
+
+  // Candidates are collected in creation order (least recently created first),
+  // which is stable and independent of activation history. Windows without a
+  // native host cannot be presented and are skipped.
+  std::vector<BrowserWindowInterface*> browsers;
+  std::vector<browser_cli::ReopenWindowCandidate> candidates;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&browsers, &candidates](BrowserWindowInterface* browser) {
+        if (!browser->GetWindow()) {
+          return true;
+        }
+        views::NativeWidgetMacNSWindowHost* host =
+            views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+                browser->GetWindow()->GetNativeWindow());
+        if (!host) {
+          return true;
+        }
+        browser_cli::ReopenWindowCandidate candidate;
+        const BrowserWindowInterface::Type type = browser->GetType();
+        candidate.is_reusable_browser_window =
+            type != BrowserWindowInterface::TYPE_APP &&
+            type != BrowserWindowInterface::TYPE_DEVTOOLS;
+        candidate.is_user_owned = host->IsUserExplicitOwned();
+        browsers.push_back(browser);
+        candidates.push_back(candidate);
+        return true;
+      },
+      BrowserCollection::Order::kCreation);
+
+  const size_t selected = browser_cli::SelectReopenWindowCandidate(candidates);
+  if (selected == browser_cli::kNoReopenWindow) {
+    return false;
+  }
+  return PresentBrowserWindowUserExplicitly(browsers[selected]);
+}
