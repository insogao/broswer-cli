# Browser CLI Phase 1: 原版 Chromium 的单一 out/Dev 构建配置。
# 在 Xcode / checkout / 磁盘门禁满足后用于 /Users/jiangao/dev/chromium/src/out/Dev/args.gn。
is_debug = false
is_component_build = true
symbol_level = 0
target_cpu = "arm64"
use_lld = false
# Browser CLI product branding (see config/product-identity.env and
# chromium/patches/002-browser-cli-branding.patch).
branding_file_path = "//chrome/app/theme/browser_cli/BRANDING"
# macOS app icon assets generated by scripts/generate-icons.sh from the
# approved source artwork (app.icns + Assets.car).
mac_app_icon_dir = "app/theme/browser_cli/mac"
