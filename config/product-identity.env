# Browser CLI product & signing identity: SINGLE SOURCE OF TRUTH.
#
# Versioned, non-secret values only. Do not duplicate these values in scripts
# or docs; everything derives from here and is checked by
# tests/check-identity-consistency.sh against:
#   * chromium/args.gn (branding_file_path)
#   * the Chromium checkout's chrome/app/theme/browser_cli/BRANDING
#
# Rules (see AGENTS.md):
#   * signing must select the certificate by SHA-1, never by a fuzzy name;
#   * ad-hoc signing ("-") is forbidden for product builds;
#   * never create/import/delete/export/revoke keychain items; only
#     `security find-identity` (read-only) and `codesign` are allowed.

# Product name (drives .app bundle name, executable, helpers, framework).
BROWSER_CLI_PRODUCT_NAME="Browser CLI"

# Stable main bundle identifier; Chromium derives helpers/framework from it
# (e.g. .helper, .helper.renderer, .framework, .framework.AlertNotificationService).
BROWSER_CLI_BUNDLE_ID="com.jiangao.browsercli"

# Apple Developer Team ID (also the OU of the signing certificate).
BROWSER_CLI_TEAM_ID="RAXC5D3A3S"

# Developer ID Application identity, pinned by SHA-1 and full name.
BROWSER_CLI_CODESIGN_IDENTITY_SHA1="E4F416DE4CD44E214B61053F2542512A0B33AF52"
BROWSER_CLI_CODESIGN_IDENTITY_NAME="Developer ID Application: jian gao (RAXC5D3A3S)"
