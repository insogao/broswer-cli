+#include "content/public/common/content_switches.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/switches.h"
+
+namespace browser_cli {
+namespace {
+
+base::CommandLine ShowCommandLine() {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  command_line.AppendSwitch(kBrowserCliUserExplicitShowSwitch);
+  return command_line;
+}
+
+TEST(UserExplicitShowRequestTest, NoSwitchIsNotRequested) {
+  const base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  EXPECT_EQ(ClassifyUserExplicitShowRequest(command_line),
+            UserExplicitShowRequestClass::kNotRequested);
+}
+
+TEST(UserExplicitShowRequestTest, PlainSwitchIsShow) {
+  EXPECT_EQ(ClassifyUserExplicitShowRequest(ShowCommandLine()),
+            UserExplicitShowRequestClass::kShow);
+}
+
+TEST(UserExplicitShowRequestTest, SupportingSwitchesKeepShow) {
+  base::CommandLine command_line = ShowCommandLine();
+  command_line.AppendSwitch("no-startup-window");
+  command_line.AppendSwitch("browser-cli-background-presentation");
+  command_line.AppendSwitchASCII("user-data-dir", "/tmp/browser-cli-profile");
+  command_line.AppendSwitchASCII("profile-directory", "Default");
+  EXPECT_EQ(ClassifyUserExplicitShowRequest(command_line),
+            UserExplicitShowRequestClass::kShow);
+}
+
+TEST(UserExplicitShowRequestTest, UrlArgumentIsBlocked) {
+  base::CommandLine command_line = ShowCommandLine();
+  command_line.AppendArg("https://example.com/");
+  EXPECT_EQ(ClassifyUserExplicitShowRequest(command_line),
+            UserExplicitShowRequestClass::kBlockedByLaunchArguments);
+}
+
+TEST(UserExplicitShowRequestTest, AppSwitchIsBlocked) {
+  base::CommandLine command_line = ShowCommandLine();
+  command_line.AppendSwitchASCII(switches::kApp, "https://example.com/");
+  EXPECT_EQ(ClassifyUserExplicitShowRequest(command_line),
+            UserExplicitShowRequestClass::kBlockedByLaunchArguments);
+}
+
+TEST(UserExplicitShowRequestTest, AppIdSwitchIsBlocked) {
+  base::CommandLine command_line = ShowCommandLine();
+  command_line.AppendSwitchASCII(switches::kAppId, "abcdefghijklmnop");
+  EXPECT_EQ(ClassifyUserExplicitShowRequest(command_line),
+            UserExplicitShowRequestClass::kBlockedByLaunchArguments);
+}
+
+TEST(UserExplicitShowRequestTest, IncognitoSwitchIsBlocked) {
+  base::CommandLine command_line = ShowCommandLine();
+  command_line.AppendSwitch(switches::kIncognito);
+  EXPECT_EQ(ClassifyUserExplicitShowRequest(command_line),
+            UserExplicitShowRequestClass::kBlockedByLaunchArguments);
+}
+
+TEST(UserExplicitShowRequestTest, EnableAutomationSwitchIsBlocked) {
+  base::CommandLine command_line = ShowCommandLine();
+  command_line.AppendSwitch(switches::kEnableAutomation);
+  EXPECT_EQ(ClassifyUserExplicitShowRequest(command_line),
+            UserExplicitShowRequestClass::kBlockedByLaunchArguments);
+}
+
+TEST(UserExplicitShowRequestTest, HeadlessSwitchIsBlocked) {
+  base::CommandLine command_line = ShowCommandLine();
+  command_line.AppendSwitch(switches::kHeadless);
+  EXPECT_EQ(ClassifyUserExplicitShowRequest(command_line),
+            UserExplicitShowRequestClass::kBlockedByLaunchArguments);
+}
+
+TEST(UserExplicitShowPlanTest, NotRequestedIsNoAction) {
+  EXPECT_EQ(PlanUserExplicitShow(UserExplicitShowRequestClass::kNotRequested,
+                                 /*managed_mode_enabled=*/true,
+                                 /*has_reusable_window=*/true),
+            UserExplicitShowPlan::kNoAction);
+}
+
+TEST(UserExplicitShowPlanTest, BlockedLaunchArgumentsAreNoAction) {
+  EXPECT_EQ(PlanUserExplicitShow(
+                UserExplicitShowRequestClass::kBlockedByLaunchArguments,
+                /*managed_mode_enabled=*/true, /*has_reusable_window=*/true),
+            UserExplicitShowPlan::kNoAction);
+}
+
+TEST(UserExplicitShowPlanTest, UnmanagedModeIsNoAction) {
+  EXPECT_EQ(PlanUserExplicitShow(UserExplicitShowRequestClass::kShow,
+                                 /*managed_mode_enabled=*/false,
+                                 /*has_reusable_window=*/false),
+            UserExplicitShowPlan::kNoAction);
+  EXPECT_EQ(PlanUserExplicitShow(UserExplicitShowRequestClass::kShow,
+                                 /*managed_mode_enabled=*/false,
+                                 /*has_reusable_window=*/true),
+            UserExplicitShowPlan::kNoAction);
+}
+
+TEST(UserExplicitShowPlanTest, ManagedModePresentsExistingWindow) {
+  EXPECT_EQ(PlanUserExplicitShow(UserExplicitShowRequestClass::kShow,
+                                 /*managed_mode_enabled=*/true,
+                                 /*has_reusable_window=*/true),
+            UserExplicitShowPlan::kPresentExistingWindow);
+}
+
+TEST(UserExplicitShowPlanTest, ManagedModeCreatesWindowWithoutReusableWindow) {
+  EXPECT_EQ(PlanUserExplicitShow(UserExplicitShowRequestClass::kShow,
+                                 /*managed_mode_enabled=*/true,
+                                 /*has_reusable_window=*/false),
+            UserExplicitShowPlan::kCreateWindowThenPresent);
+}
+
+}  // namespace
+}  // namespace browser_cli
