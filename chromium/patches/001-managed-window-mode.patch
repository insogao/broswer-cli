+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_VIEWS_WIDGET_BROWSER_CLI_FOREGROUND_ORIGIN_H_
+#define UI_VIEWS_WIDGET_BROWSER_CLI_FOREGROUND_ORIGIN_H_
+
+// Chrome-facing include for attributing presentation requests to a foreground
+// origin. The origin vocabulary, the policy singleton and the thread-local
+// attribution state all live inside the ui/views component, so there is exactly
+// one of each per process even though callers outside ui/views only link the
+// component (never the policy implementation target).
+//
+// Usage from an automation producer, for example the extension windows API:
+//
+//   views::ScopedForegroundOrigin scope(views::ForegroundOrigin::kExtension);
+//   browser_window->Activate();  // attributed kExtension for this call
+//
+// The scope only attributes the request; the policy still decides. Automation
+// is denied on a HUMAN-owned window, and every action except bounds changes is
+// denied on an unowned background window. `PresentForUserExplicitAction()` is
+// never affected by a scope.
+#include "ui/views/widget/browser_cli_presentation_policy.h"
+
+#endif  // UI_VIEWS_WIDGET_BROWSER_CLI_FOREGROUND_ORIGIN_H_
diff --git a/ui/views/widget/browser_cli_presentation_policy.cc b/ui/views/widget/browser_cli_presentation_policy.cc
new file mode 100644
index 0000000000..79407fc665
--- /dev/null
+++ b/ui/views/widget/browser_cli_presentation_policy.cc
@@ -0,0 +1,276 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/views/widget/browser_cli_presentation_policy.h"
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+
+namespace views {
+namespace {
+
+const char* OriginToString(ForegroundOrigin origin) {
+  switch (origin) {
+    case ForegroundOrigin::kUserExplicit:
+      return "user-explicit";
+    case ForegroundOrigin::kAgentAssist:
+      return "agent-assist";
+    case ForegroundOrigin::kExtension:
+      return "extension";
+    case ForegroundOrigin::kWebPage:
+      return "web-page";
+    case ForegroundOrigin::kInternal:
+      return "internal";
+    case ForegroundOrigin::kSessionRestore:
+      return "session-restore";
+  }
+}
+
+const char* ActionToString(BrowserCliPresentationAction action) {
+  switch (action) {
+    case BrowserCliPresentationAction::kShowAndActivate:
+      return "show-and-activate";
+    case BrowserCliPresentationAction::kShowInactive:
+      return "show-inactive";
+    case BrowserCliPresentationAction::kMinimize:
+      return "minimize";
+    case BrowserCliPresentationAction::kMaximize:
+      return "maximize";
+    case BrowserCliPresentationAction::kRestore:
+      return "restore";
+    case BrowserCliPresentationAction::kDeactivate:
+      return "deactivate";
+    case BrowserCliPresentationAction::kFullscreen:
+      return "fullscreen";
+    case BrowserCliPresentationAction::kSetBounds:
+      return "set-bounds";
+    case BrowserCliPresentationAction::kSetZOrder:
+      return "set-z-order";
+  }
+}
+
+const char* StateToString(BrowserCliPresentationState state) {
+  switch (state) {
+    case BrowserCliPresentationState::kUnmanaged:
+      return "unmanaged";
+    case BrowserCliPresentationState::kBackground:
+      return "background";
+    case BrowserCliPresentationState::kHuman:
+      return "human";
+  }
+}
+
+// Automation origins may never act on a window the user explicitly owns
+// (invariant 5.3). `kInternal` is deliberately not an automation origin: it is
+// the un-attributed catch-all used by Chrome UI and native user flows.
+bool IsAutomationOrigin(ForegroundOrigin origin) {
+  switch (origin) {
+    case ForegroundOrigin::kAgentAssist:
+    case ForegroundOrigin::kExtension:
+    case ForegroundOrigin::kWebPage:
+    case ForegroundOrigin::kSessionRestore:
+      return true;
+    case ForegroundOrigin::kUserExplicit:
+    case ForegroundOrigin::kInternal:
+      return false;
+  }
+}
+
+// The origin attributed to presentation requests on the current thread.
+// Deliberately a single thread-local in this component: producers outside it
+// only see the scoped setter, so there is exactly one policy and one
+// attribution state per process.
+thread_local ForegroundOrigin g_current_foreground_origin =
+    ForegroundOrigin::kInternal;
+
+}  // namespace
+
+ForegroundOrigin CurrentForegroundOrigin() {
+  return g_current_foreground_origin;
+}
+
+ScopedForegroundOrigin::ScopedForegroundOrigin(ForegroundOrigin origin)
+    : previous_(g_current_foreground_origin) {
+  g_current_foreground_origin = origin;
+}
+
+ScopedForegroundOrigin::~ScopedForegroundOrigin() {
+  g_current_foreground_origin = previous_;
+}
+
+// static
+BrowserCliPresentationPolicy* BrowserCliPresentationPolicy::Get() {
+  static base::NoDestructor<BrowserCliPresentationPolicy> instance;
+  return instance.get();
+}
+
+BrowserCliPresentationPolicy::BrowserCliPresentationPolicy() = default;
+BrowserCliPresentationPolicy::~BrowserCliPresentationPolicy() = default;
+
+bool BrowserCliPresentationPolicy::IsManagedModeEnabled() {
+  EnsureInitializedFromCommandLine();
+  return managed_mode_enabled_;
+}
+
+void BrowserCliPresentationPolicy::EnsureInitializedFromCommandLine() {
+  if (initialized_) {
+    return;
+  }
+  initialized_ = true;
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kBrowserCliBackgroundPresentationSwitch)) {
+    return;
+  }
+  managed_mode_enabled_ = true;
+  state_ = BrowserCliPresentationState::kBackground;
+  LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=policy transition=background"
+            << " reason=command-line-switch window_id=0";
+}
+
+bool BrowserCliPresentationPolicy::AllowPresentation(
+    ForegroundOrigin origin,
+    BrowserCliPresentationAction action,
+    uint64_t window_id) {
+  EnsureInitializedFromCommandLine();
+  if (!managed_mode_enabled_) {
+    return true;
+  }
+
+  bool allow = false;
+  const char* reason = nullptr;
+  bool newly_owned = false;
+  const bool owned = user_explicit_owned_window_ids_.count(window_id) > 0;
+  if (origin == ForegroundOrigin::kUserExplicit) {
+    // Invariant 5.2: explicit user actions always win. Ownership is granted
+    // per window, never process-wide (invariant 5.1 stays intact for every
+    // other window).
+    allow = true;
+    reason = "user-explicit-always-allowed";
+    if (window_id != 0) {
+      newly_owned = user_explicit_owned_window_ids_.insert(window_id).second;
+    }
+  } else if (owned && IsAutomationOrigin(origin)) {
+    // Invariant 5.3: the user's window is never shown, hidden, minimized,
+    // restored, maximized, fullscreened, deactivated, moved or resized by
+    // automation.
+    allow = false;
+    reason = "human-owned-window-automation-denied";
+  } else if (owned) {
+    // Chrome UI and native user flows that cannot be attributed further stay
+    // allowed on the user's own window.
+    allow = true;
+    reason = "human-owned-window-internal-allowed";
+  } else if (action == BrowserCliPresentationAction::kSetBounds) {
+    // Proven non-presenting for a hidden managed window: the macOS chain
+    // (BrowserView::SetBounds -> Widget::SetBounds ->
+    // NativeWidgetMac::SetBounds -> host SetBoundsInScreen -> bridge
+    // SetBounds) only calls
+    // -[NSWindow setFrame:display:animate:] plus a key-window-guarded
+    // reactivation that the per-window suppression backstop rejects. Chrome's
+    // own layout/restore and background automation need to arrange windows, so
+    // this single action stays allowed on unowned windows.
+    allow = true;
+    reason = "background-bounds-change-never-presents";
+  } else {
+    // Every other action is denied on an unowned window: Restore / Maximize /
+    // Fullscreen / SetZOrder can implicitly show or re-order a hidden window,
+    // so they must not be allowed in the background for any origin.
+    allow = false;
+    reason = "background-suppresses-native-presentation";
+  }
+
+  if (newly_owned) {
+    LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=policy"
+              << " transition=human-ownership-granted"
+              << " window_id=" << window_id
+              << " owned_windows=" << user_explicit_owned_window_ids_.size()
+              << " reason=user-explicit-presentation";
+  }
+
+  // Keep the Gate A "no internal allow in background" contract exact and the
+  // logs quiet: the only allow an unowned window can produce is the
+  // non-presenting bounds change, which is not a policy decision worth logging
+  // when it is un-attributed (window creation/layout/session restore).
+  // Denials and every automation decision are always logged.
+  const bool owned_after = owned || newly_owned;
+  const bool quiet_allow = allow &&
+                           action == BrowserCliPresentationAction::kSetBounds &&
+                           !owned_after && !IsAutomationOrigin(origin);
+  if (!quiet_allow) {
+    LogDecision(origin, action, window_id, /*owned=*/owned_after, allow,
+                reason);
+  }
+  return allow;
+}
+
+void BrowserCliPresentationPolicy::ReleaseUserExplicitOwnership(
+    uint64_t window_id,
+    const char* reason) {
+  EnsureInitializedFromCommandLine();
+  if (!managed_mode_enabled_) {
+    return;
+  }
+  if (user_explicit_owned_window_ids_.erase(window_id) == 0) {
+    return;
+  }
+  LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=policy"
+            << " transition=human-ownership-released"
+            << " window_id=" << window_id
+            << " owned_windows=" << user_explicit_owned_window_ids_.size()
+            << " reason=" << reason;
+}
+
+bool BrowserCliPresentationPolicy::IsUserExplicitOwned(
+    uint64_t window_id) const {
+  return user_explicit_owned_window_ids_.count(window_id) > 0;
+}
+
+void BrowserCliPresentationPolicy::ResetForTesting() {
+  initialized_ = false;
+  managed_mode_enabled_ = false;
+  state_ = BrowserCliPresentationState::kUnmanaged;
+  decision_count_ = 0;
+  user_explicit_owned_window_ids_.clear();
+  g_current_foreground_origin = ForegroundOrigin::kInternal;
+}
+
+void BrowserCliPresentationPolicy::SetManagedModeEnabledForTesting(
+    bool enabled) {
+  initialized_ = true;
+  managed_mode_enabled_ = enabled;
+  state_ = enabled ? BrowserCliPresentationState::kBackground
+                   : BrowserCliPresentationState::kUnmanaged;
+  user_explicit_owned_window_ids_.clear();
+}
+
+void BrowserCliPresentationPolicy::LogDecision(
+    ForegroundOrigin origin,
+    BrowserCliPresentationAction action,
+    uint64_t window_id,
+    bool owned,
+    bool allow,
+    const char* reason) {
+  // `state=` describes the window the decision is about: a USER_EXPLICIT-owned
+  // window is `human` even though the browser mode stays `background`. This
+  // keeps "no internal allow in background" assertions precise.
+  const BrowserCliPresentationState window_state =
+      state_ == BrowserCliPresentationState::kBackground && owned
+          ? BrowserCliPresentationState::kHuman
+          : state_;
+  ++decision_count_;
+  LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=policy"
+            << " seq=" << decision_count_
+            << " decision=" << (allow ? "allow" : "deny")
+            << " action=" << ActionToString(action)
+            << " origin=" << OriginToString(origin)
+            << " window_id=" << window_id
+            << " state=" << StateToString(window_state)
+            << " owned=" << (owned ? "yes" : "no")
+            << " owned_windows=" << user_explicit_owned_window_ids_.size()
+            << " reason=" << reason;
+}
+
+}  // namespace views
diff --git a/ui/views/widget/browser_cli_presentation_policy.h b/ui/views/widget/browser_cli_presentation_policy.h
new file mode 100644
index 0000000000..4e2f6bdae8
--- /dev/null
+++ b/ui/views/widget/browser_cli_presentation_policy.h
@@ -0,0 +1,221 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_VIEWS_WIDGET_BROWSER_CLI_PRESENTATION_POLICY_H_
+#define UI_VIEWS_WIDGET_BROWSER_CLI_PRESENTATION_POLICY_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <set>
+
+#include "base/no_destructor.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/views_export.h"
+
+namespace views {
+
+// Browser CLI foreground attribution and window-presentation policy.
+//
+// This is the single decision point for "may this window become natively
+// visible / active" (docs/browser-cli-development-plan.md sections 3-6):
+//
+//   * background-origin presentation must never reach the desktop;
+//   * explicit user actions always win (invariant 5.2);
+//   * ownership is per window: a USER_EXPLICIT presentation marks that one
+//     window as HUMAN-owned (invariant 5.1);
+//   * a HUMAN-owned window is never shown, hidden, minimized, restored,
+//     maximized, fullscreened, deactivated, moved, resized or re-ordered by an
+//     automation origin (agent assist / extension / web page / session
+//     restore), while un-attributed Chrome-internal requests stay allowed so
+//     native user flows and AppKit window controls keep working (invariant
+//     5.3). A user takeover never becomes a process-wide allow;
+//   * an unowned window stays suppressed for every non-user origin. The only
+//     exception is a programmatic bounds change (kSetBounds), which is proven
+//     not to present a hidden window on macOS (see AllowPresentation).
+//
+// The policy is inert unless the command line contains
+// `--browser-cli-background-presentation`, so stock Chromium behavior is
+// unchanged.
+//
+// TODO(browser-cli/phase3): kAgentAssist still has no producer; and some
+// automation entry points cannot be attributed safely yet (see the phase
+// document): `BrowserWebContentsDelegate::ActivateContents` is shared between
+// renderer/CDP activation and user-benefiting Chrome features, and session
+// restore shows windows through the app-shim bridge, below this policy.
+//
+// All methods must be called on the browser UI thread.
+
+// Command-line switch that enables managed background presentation.
+inline constexpr char kBrowserCliBackgroundPresentationSwitch[] =
+    "browser-cli-background-presentation";
+
+// Minimal, extensible foreground attribution model (development plan
+// section 3). Values are stable model vocabulary; adding a producer for an
+// existing value must not change how the other origins are treated.
+enum class ForegroundOrigin {
+  // Dock / Launchpad / app reopen / menu bar / CLI explicit `show`.
+  kUserExplicit,
+  // Reserved (Phase 4): requestForeground for login / captcha / confirmation.
+  kAgentAssist,
+  // `chrome.windows.create/update` automation.
+  kExtension,
+  // Renderer-requested presentation (`window.open` focus, windowing controls).
+  kWebPage,
+  // Browser-internal maintenance, capture, recovery and Chrome UI.
+  kInternal,
+  // Session restore.
+  kSessionRestore,
+};
+
+// The foreground origin attributed to presentation requests made on the
+// current thread. Defaults to ForegroundOrigin::kInternal. Producers that can
+// be attributed safely wrap their synchronous browser-window request with
+// ScopedForegroundOrigin; the state lives inside the ui/views component so
+// that the single BrowserCliPresentationPolicy instance observes it.
+VIEWS_EXPORT ForegroundOrigin CurrentForegroundOrigin();
+
+// Scopes the origin of presentation requests issued while this object is
+// alive. Thread-local, not copyable, and nestable (the previous value is
+// restored on destruction). Producers use this to attribute automation
+// requests so the policy can keep them away from a HUMAN-owned window.
+class VIEWS_EXPORT ScopedForegroundOrigin {
+ public:
+  explicit ScopedForegroundOrigin(ForegroundOrigin origin);
+  ~ScopedForegroundOrigin();
+
+  ScopedForegroundOrigin(const ScopedForegroundOrigin&) = delete;
+  ScopedForegroundOrigin& operator=(const ScopedForegroundOrigin&) = delete;
+
+ private:
+  const ForegroundOrigin previous_;
+};
+
+// Native presentation and programmatic window-state requests that are subject
+// to the policy. The first three reach the native visibility gateway
+// (SetVisibilityState); the others are ui::BaseWindow state changes that can
+// still implicitly show or re-order a hidden window (restore, maximize,
+// fullscreen, z-order), so they are denied for automation on HUMAN-owned
+// windows and denied altogether on unowned windows except kSetBounds, which is
+// proven non-presenting.
+enum class BrowserCliPresentationAction {
+  kShowAndActivate,
+  kShowInactive,
+  kMinimize,
+  kMaximize,
+  kRestore,
+  kDeactivate,
+  kFullscreen,
+  kSetBounds,
+  kSetZOrder,
+};
+
+// Objective-C-free entry point to the per-window programmatic-change policy for
+// C++ translation units that cannot include the Cocoa headers of
+// NativeWidgetMacNSWindowHost. Implemented inside the ui/views component.
+// Returns true when `native_window` has no views host (stock behavior) and
+// otherwise forwards to
+// NativeWidgetMacNSWindowHost::AllowProgrammaticChangeFromCurrentOrigin().
+VIEWS_EXPORT bool AllowProgrammaticWindowChangeFromCurrentOrigin(
+    gfx::NativeWindow native_window,
+    BrowserCliPresentationAction action);
+
+enum class BrowserCliPresentationState {
+  // No switch: stock Chromium behavior, every request is allowed.
+  kUnmanaged,
+  // Managed background: user-explicit requests always present. Windows the
+  // user owns additionally answer internal requests, while automation origins
+  // stay denied.
+  kBackground,
+  // Per-window USER_EXPLICIT/HUMAN ownership of the window a decision is
+  // about. This state is never applied process-wide: a `kHuman` window does
+  // not authorize any other window to present. Reported in decision logs via
+  // `state=`; use IsUserExplicitOwned() to query it for a window id.
+  kHuman,
+};
+
+class VIEWS_EXPORT BrowserCliPresentationPolicy {
+ public:
+  // Always returns the process-wide instance.
+  static BrowserCliPresentationPolicy* Get();
+
+  BrowserCliPresentationPolicy(const BrowserCliPresentationPolicy&) = delete;
+  BrowserCliPresentationPolicy& operator=(const BrowserCliPresentationPolicy&) =
+      delete;
+
+  // Reads the command-line switch on first use; cheap afterwards. Exposed so
+  // UI code can tag windows as managed at creation time.
+  bool IsManagedModeEnabled();
+
+  // The single decision point. Logs every decision while managed mode is
+  // enabled and returns true when the request may proceed.
+  //
+  // A `kUserExplicit` request is always allowed and additionally establishes
+  // per-window USER_EXPLICIT/HUMAN ownership for `window_id`.
+  //
+  // A HUMAN-owned window answers `kInternal` requests (Chrome UI and native
+  // user flows that cannot be attributed further, for example the user-facing
+  // "Minimize window" action) and denies every automation origin (kAgentAssist
+  // / kExtension / kWebPage / kSessionRestore) for every action: automation
+  // must not show, minimize, re-show, restore, maximize, fullscreen,
+  // deactivate, move or resize a window the user owns (invariant 5.3).
+  //
+  // Windows the user does not own keep the BACKGROUND invariant for every
+  // action and every non-user origin, with one proven exception: kSetBounds
+  // only changes the frame of a hidden managed window
+  // (BrowserView::SetBounds -> Widget::SetBounds -> NativeWidgetMac::SetBounds
+  // -> host SetBoundsInScreen -> bridge SetBounds -> -[NSWindow
+  // setFrame:display:animate:]), and the single presentation-capable branch in
+  // that chain (a key-window-guarded reactivation) is rejected by the
+  // per-window suppression backstop. Restore / Maximize / Fullscreen /
+  // SetZOrder are denied because they can implicitly show or raise a hidden
+  // window.
+  bool AllowPresentation(ForegroundOrigin origin,
+                         BrowserCliPresentationAction action,
+                         uint64_t window_id);
+
+  // Drops per-window USER_EXPLICIT/HUMAN ownership. Called when the user hands
+  // a window back to the agent or when the window is destroyed, so a stale
+  // window id can never authorize a later presentation. No-op when the id is
+  // not owned; no-op while managed mode is disabled.
+  void ReleaseUserExplicitOwnership(uint64_t window_id, const char* reason);
+
+  // Whether `window_id` is currently USER_EXPLICIT/HUMAN-owned.
+  bool IsUserExplicitOwned(uint64_t window_id) const;
+
+  // Testing helpers. Reset restores the uninitialized (switch-driven) state.
+  void ResetForTesting();
+  void SetManagedModeEnabledForTesting(bool enabled);
+  BrowserCliPresentationState state_for_testing() const { return state_; }
+  size_t user_explicit_owned_window_count_for_testing() const {
+    return user_explicit_owned_window_ids_.size();
+  }
+
+ private:
+  friend class base::NoDestructor<BrowserCliPresentationPolicy>;
+
+  BrowserCliPresentationPolicy();
+  ~BrowserCliPresentationPolicy();
+
+  void EnsureInitializedFromCommandLine();
+  void LogDecision(ForegroundOrigin origin,
+                   BrowserCliPresentationAction action,
+                   uint64_t window_id,
+                   bool owned,
+                   bool allow,
+                   const char* reason);
+
+  bool initialized_ = false;
+  bool managed_mode_enabled_ = false;
+  BrowserCliPresentationState state_ = BrowserCliPresentationState::kUnmanaged;
+  uint64_t decision_count_ = 0;
+
+  // Per-window USER_EXPLICIT/HUMAN ownership (see AllowPresentation). This is
+  // deliberately a set of window ids, not a process-wide boolean.
+  std::set<uint64_t> user_explicit_owned_window_ids_;
+};
+
+}  // namespace views
+
+#endif  // UI_VIEWS_WIDGET_BROWSER_CLI_PRESENTATION_POLICY_H_
