diff --git a/chrome/browser/app_controller_mac_unittest.mm b/chrome/browser/app_controller_mac_unittest.mm
index 1629d6c9b8..3fba9a1911 100644
--- a/chrome/browser/app_controller_mac_unittest.mm
+++ b/chrome/browser/app_controller_mac_unittest.mm
@@ -31,6 +31,7 @@
 #include "testing/platform_test.h"
 #include "ui/base/l10n/l10n_util_mac.h"
 #include "ui/base/window_open_disposition.h"
+#include "ui/views/widget/browser_cli_foreground_origin.h"
 
 namespace {
 
@@ -594,3 +595,49 @@ void TearDown() override {
       app_controller_mac::kIgnoreOnFailure);
   run_loop.Run();
 }
+
+// Browser CLI: the app controller re-applies the origin captured at request
+// time around delayed work through the shared RunWithForegroundOrigin()
+// helper (the same helper TabRestorer::TabRestoreServiceLoaded() uses). This
+// covers the production seam: the helper must scope the value to its callback
+// only, and a request captured without attribution must stay unattributed.
+// Pure logic: no window is created or shown.
+TEST_F(AppControllerTest, RunWithForegroundOriginScopesOnlyItsCallback) {
+  EXPECT_EQ(views::CurrentForegroundOrigin(),
+            views::ForegroundOrigin::kUnknown);
+
+  // A user menu dispatch scopes USER_EXPLICIT synchronously; RestoreByID()
+  // captures this value by value before the stack unwinds.
+  views::ForegroundOrigin captured = views::ForegroundOrigin::kUnknown;
+  {
+    views::ScopedForegroundOrigin menu_scope(
+        views::ForegroundOrigin::kUserExplicit);
+    captured = views::CurrentForegroundOrigin();
+  }
+  EXPECT_EQ(views::CurrentForegroundOrigin(),
+            views::ForegroundOrigin::kUnknown);
+
+  bool callback_saw_user_explicit = false;
+  app_controller_mac::RunWithForegroundOrigin(
+      captured, base::BindLambdaForTesting([&callback_saw_user_explicit]() {
+        callback_saw_user_explicit = views::CurrentForegroundOrigin() ==
+                                     views::ForegroundOrigin::kUserExplicit;
+      }));
+  EXPECT_TRUE(callback_saw_user_explicit);
+  // The scope unwinds with the callback.
+  EXPECT_EQ(views::CurrentForegroundOrigin(),
+            views::ForegroundOrigin::kUnknown);
+
+  // An unattributed request (for example a background / SessionRestore path)
+  // cannot borrow the user origin.
+  bool background_saw_user_explicit = false;
+  app_controller_mac::RunWithForegroundOrigin(
+      views::ForegroundOrigin::kUnknown,
+      base::BindLambdaForTesting([&background_saw_user_explicit]() {
+        background_saw_user_explicit = views::CurrentForegroundOrigin() ==
+                                       views::ForegroundOrigin::kUserExplicit;
+      }));
+  EXPECT_FALSE(background_saw_user_explicit);
+  EXPECT_EQ(views::CurrentForegroundOrigin(),
+            views::ForegroundOrigin::kUnknown);
+}
