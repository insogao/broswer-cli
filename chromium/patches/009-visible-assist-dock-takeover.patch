@@ -25,4 +27,55 @@ size_t SelectReopenWindowCandidate(
                                                    : most_recent_reusable;
 }
 
+size_t SelectReopenFocusCandidate(
+    base::span<const ReopenFocusCandidate> candidates) {
+  size_t frontmost = kNoReopenFocusCandidate;
+  size_t frontmost_miniaturized = kNoReopenFocusCandidate;
+  bool all_miniaturized = true;
+  for (size_t index = 0; index < candidates.size(); ++index) {
+    const ReopenFocusCandidate& candidate = candidates[index];
+    if (candidate.is_miniaturized) {
+      // Candidates are in back-to-front order, so a later index is closer to
+      // the front.
+      frontmost_miniaturized = index;
+    } else if (candidate.is_visible) {
+      all_miniaturized = false;
+      if (candidate.is_on_active_space) {
+        frontmost = index;
+      }
+    }
+  }
+  if (all_miniaturized && frontmost_miniaturized != kNoReopenFocusCandidate) {
+    frontmost = frontmost_miniaturized;
+  }
+  return frontmost;
+}
+
+ManagedDockReopenResult HandleManagedDockReopen(
+    base::span<const ManagedDockReopenCandidate> candidates,
+    const ManagedDockPresentCallback& present) {
+  std::vector<ReopenFocusCandidate> focus_candidates;
+  focus_candidates.reserve(candidates.size());
+  for (const ManagedDockReopenCandidate& candidate : candidates) {
+    focus_candidates.push_back(candidate.focus);
+  }
+  const size_t selected = SelectReopenFocusCandidate(focus_candidates);
+  if (selected == kNoReopenFocusCandidate) {
+    return {};
+  }
+  const uint64_t window_id = candidates[selected].window_id;
+  if (window_id == 0) {
+    // The focus target has no managed host, so the gateway cannot attribute it.
+    // Never fall back to touching AppKit directly; the caller uses the gated
+    // reuse/create path instead.
+    return {};
+  }
+  if (present.Run(window_id)) {
+    return {ManagedDockReopenOutcome::kPresented, window_id};
+  }
+  // The gateway refused or failed: report the same target (for the failure log)
+  // but do not activate it.
+  return {ManagedDockReopenOutcome::kNotPresented, window_id};
+}
+
 }  // namespace browser_cli
