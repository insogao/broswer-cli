+// Browser CLI: structured observation log for one Dock / Launchpad / app reopen
+// request. A single reopen is correlated by |request_id| across the
+// reopen-enter / profile-ready / window-created / present-return boundaries and
+// carries the |branch| (reused / new / terminal fallback) plus the outcome.
+// Every record has the monotonic |elapsed_ms| since reopen-enter together with
+// the wall-clock |wall_ms| (Unix epoch milliseconds), so samples of an external
+// window-count watcher using the same epoch clock can be aligned with these
+// boundaries. Observation only: nothing is shown, hidden or activated by this
+// logging, and -applicationDidBecomeActive is deliberately not treated as a
+// user click (development plan section 3).
+std::string NewBrowserCliDockReopenRequestId() {
+  static std::atomic<uint64_t> sequence{0};
+  return "dock-reopen-" + base::NumberToString(base::GetCurrentProcId()) + "-" +
+         base::NumberToString(++sequence);
+}
+
+void LogBrowserCliDockReopenBoundary(const std::string& request_id,
+                                     base::TimeTicks reopen_start,
+                                     const char* stage,
+                                     const char* branch,
+                                     const char* result,
+                                     bool managed) {
+  LOG(INFO) << "BROWSER_CLI_DOCK_REOPEN stage=" << stage
+            << " request_id=" << request_id << " branch=" << branch
+            << " result=" << result << " elapsed_ms="
+            << (base::TimeTicks::Now() - reopen_start).InMilliseconds()
+            << " wall_ms=" << base::Time::Now().InMillisecondsSinceUnixEpoch()
+            << " managed=" << (managed ? "yes" : "no");
+}
+
 // Activates a browser window having the given profile (the last one active) if
 // possible or creates an empty one if necessary. Returns a pointer to the
 // activated/new |BrowserWindowInterface|.
@@ -1858,6 +1894,22 @@ - (BOOL)applicationShouldHandleReopen:(NSApplication*)theApplication
   if (browser_shutdown::IsTryingToQuit())
