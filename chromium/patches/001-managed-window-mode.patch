--- /dev/null
+++ b/components/remote_cocoa/app_shim/browser_cli_managed_presentation_unittests.mm
@@ -0,0 +1,84 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <AppKit/AppKit.h>
+
+#import "components/remote_cocoa/app_shim/native_widget_mac_nswindow.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/cocoa/window_size_constants.h"
+
+namespace {
+
+// Browser CLI Phase 2 tests for the AppKit-level managed-window hard stop.
+//
+// The window frame is intentionally far offscreen: if the suppression guard
+// ever regresses, the test would still detect ordering (isVisible becomes YES)
+// without ever putting a window in front of the user. The tests never order
+// the window in while the guard is lifted, so no visible window is created.
+
+NativeWidgetMacNSWindow* CreateTestWindow() {
+  NativeWidgetMacNSWindow* window = [[NativeWidgetMacNSWindow alloc]
+      initWithContentRect:ui::kWindowSizeDeterminedLater
+                styleMask:NSWindowStyleMaskTitled
+                  backing:NSBackingStoreBuffered
+                    defer:NO];
+  [window setFrame:NSMakeRect(-10000, -10000, 100, 100) display:NO];
+  return window;
+}
+
+}  // namespace
+
+TEST(BrowserCliManagedPresentationTest, DefaultsToNotSuppressed) {
+  @autoreleasepool {
+    NativeWidgetMacNSWindow* window = CreateTestWindow();
+    EXPECT_FALSE(window.managedPresentationSuppressed);
+    [window close];
+  }
+}
+
+TEST(BrowserCliManagedPresentationTest,
+     SuppressedWindowIgnoresAllPresentationEntryPoints) {
+  @autoreleasepool {
+    NativeWidgetMacNSWindow* window = CreateTestWindow();
+    window.managedPresentationSuppressed = YES;
+    EXPECT_FALSE([window isVisible]);
+
+    [window orderFront:nil];
+    EXPECT_FALSE([window isVisible]);
+
+    [window orderFrontRegardless];
+    EXPECT_FALSE([window isVisible]);
+
+    [window orderBack:nil];
+    EXPECT_FALSE([window isVisible]);
+
+    [window orderWindow:NSWindowAbove relativeTo:0];
+    EXPECT_FALSE([window isVisible]);
+
+    [window orderWindow:NSWindowBelow relativeTo:0];
+    EXPECT_FALSE([window isVisible]);
+
+    [window makeKeyAndOrderFront:nil];
+    EXPECT_FALSE([window isVisible]);
+
+    [window makeKeyWindow];
+    EXPECT_FALSE([window isKeyWindow]);
+
+    [window miniaturize:nil];
+    EXPECT_FALSE([window isMiniaturized]);
+
+    // Ordering out must stay allowed: it can never make a window visible.
+    [window orderWindow:NSWindowOut relativeTo:0];
+    EXPECT_FALSE([window isVisible]);
+
+    // Lifting the guard restores the default flag state. We deliberately do
+    // not order the window in afterwards (no visible window in tests).
+    window.managedPresentationSuppressed = NO;
+    EXPECT_FALSE(window.managedPresentationSuppressed);
+
+    // Re-arm before closing so teardown cannot order the window in.
+    window.managedPresentationSuppressed = YES;
+    [window close];
+  }
+}
