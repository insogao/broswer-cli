+      55, ForegroundAssistReleaseReason::kAgentRelease, first));
+  EXPECT_FALSE(policy()->IsForegroundAssistLeased(55));
+  EXPECT_EQ(policy()->GetForegroundAssistLeaseGeneration(55), 0u);
