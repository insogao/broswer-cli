diff --git a/ui/views/widget/browser_cli_foreground_lease.cc b/ui/views/widget/browser_cli_foreground_lease.cc
new file mode 100644
index 0000000000..6976f984f1
--- /dev/null
+++ b/ui/views/widget/browser_cli_foreground_lease.cc
@@ -0,0 +1,87 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/views/widget/browser_cli_foreground_lease.h"
+
+namespace views {
+
+const char* ForegroundAssistReasonToString(ForegroundAssistReason reason) {
+  switch (reason) {
+    case ForegroundAssistReason::kLogin:
+      return "login";
+    case ForegroundAssistReason::kCaptcha:
+      return "captcha";
+    case ForegroundAssistReason::kConfirmation:
+      return "confirmation";
+    case ForegroundAssistReason::kOther:
+      return "other";
+  }
+}
+
+const char* ForegroundAssistRequestResultToString(
+    ForegroundAssistRequestResult result) {
+  switch (result) {
+    case ForegroundAssistRequestResult::kGranted:
+      return "granted";
+    case ForegroundAssistRequestResult::kDenied:
+      return "denied";
+    case ForegroundAssistRequestResult::kBusy:
+      return "busy";
+    case ForegroundAssistRequestResult::kInvalidTarget:
+      return "invalid-target";
+  }
+}
+
+const char* ForegroundAssistReleaseReasonToString(
+    ForegroundAssistReleaseReason reason) {
+  switch (reason) {
+    case ForegroundAssistReleaseReason::kAgentRelease:
+      return "agent-release";
+    case ForegroundAssistReleaseReason::kTimeout:
+      return "timeout";
+    case ForegroundAssistReleaseReason::kUserTakeover:
+      return "user-takeover";
+    case ForegroundAssistReleaseReason::kWindowDestroyed:
+      return "window-destroyed";
+  }
+}
+
+bool IsForegroundLeaseActive(const ForegroundLease& lease,
+                             base::TimeTicks now) {
+  // The live interval is [granted_at, expires_at): a lease is not active
+  // before it was granted, and it is already expired at its deadline.
+  return lease.window_id != 0 && lease.granted_at <= now &&
+         now < lease.expires_at;
+}
+
+ForegroundAssistRequestDecision EvaluateForegroundAssistRequest(
+    bool managed_mode_enabled,
+    bool requester_is_agent_assist,
+    uint64_t window_id,
+    bool target_is_human_owned,
+    uint64_t active_lease_window_id) {
+  if (!managed_mode_enabled) {
+    return {ForegroundAssistRequestResult::kDenied, "unmanaged-stock-behavior"};
+  }
+  if (!requester_is_agent_assist) {
+    return {ForegroundAssistRequestResult::kDenied, "assist-origin-not-agent"};
+  }
+  if (window_id == 0) {
+    return {ForegroundAssistRequestResult::kInvalidTarget,
+            "assist-invalid-target"};
+  }
+  if (target_is_human_owned) {
+    return {ForegroundAssistRequestResult::kDenied,
+            "assist-target-human-owned"};
+  }
+  if (active_lease_window_id == window_id) {
+    return {ForegroundAssistRequestResult::kGranted, "assist-already-granted"};
+  }
+  if (active_lease_window_id != 0) {
+    return {ForegroundAssistRequestResult::kBusy, "assist-busy"};
+  }
+  return {ForegroundAssistRequestResult::kGranted, "assist-granted"};
+}
+
+}  // namespace views
diff --git a/ui/views/widget/browser_cli_foreground_lease.h b/ui/views/widget/browser_cli_foreground_lease.h
new file mode 100644
index 0000000000..0874549aa1
--- /dev/null
+++ b/ui/views/widget/browser_cli_foreground_lease.h
@@ -0,0 +1,120 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_VIEWS_WIDGET_BROWSER_CLI_FOREGROUND_LEASE_H_
+#define UI_VIEWS_WIDGET_BROWSER_CLI_FOREGROUND_LEASE_H_
+
+#include <stdint.h>
+
+#include "base/time/time.h"
+#include "ui/views/views_export.h"
+
+namespace views {
+
+// Foreground assist lease vocabulary and pure decision helpers (development
+// plan section 6, Phase 4 Slice 1).
+//
+// A lease is the only way an agent-originated request may present a managed
+// window: it is single-instance (at most one live lease per process), scoped to
+// exactly one window, and expires on its own after
+// kDefaultForegroundAssistLeaseTtl. Expiry is lazy: nothing here starts a
+// timer, shows, hides or otherwise touches a window, and the policy only
+// records the lease so the decision log and AllowPresentation() can answer the
+// lease-attributed requests that a later producer slice will issue.
+//
+// This file is deliberately free of policy and window dependencies so the
+// whole decision matrix is unit-testable without a browser process.
+
+// Why a foreground assist was requested. Fixed first-version vocabulary; the
+// strings are part of the structured log contract.
+enum class ForegroundAssistReason {
+  kLogin,
+  kCaptcha,
+  kConfirmation,
+  kOther,
+};
+
+// Outcome of one lease request.
+enum class ForegroundAssistRequestResult {
+  // A live lease now covers the requested window: newly granted, or an
+  // idempotent re-request for the window that already holds the lease.
+  kGranted,
+  // The request is refused and no lease exists: managed mode is off, the
+  // requester is not the agent, or the target is HUMAN-owned.
+  kDenied,
+  // Another window currently holds the single lease.
+  kBusy,
+  // window_id 0: the requester did not name a real target.
+  kInvalidTarget,
+};
+
+// Why a lease stopped covering its window. A user takeover releases the lease
+// before the window becomes HUMAN-owned, so no assist release path can ever
+// run for a HUMAN-owned window.
+enum class ForegroundAssistReleaseReason {
+  kAgentRelease,
+  kTimeout,
+  kUserTakeover,
+  kWindowDestroyed,
+};
+
+// Default lease lifetime. Five minutes is long enough for a login / captcha /
+// confirmation flow and short enough that a crashed agent cannot leave a
+// window presented for long. Slice 1 only records the deadline; the release
+// entry point is ReleaseExpiredForegroundAssistLeases().
+inline constexpr base::TimeDelta kDefaultForegroundAssistLeaseTtl =
+    base::Minutes(5);
+
+// One live foreground assist lease. target_tab is audit-only in Slice 1: the
+// lease authorizes exactly one window and never a set of windows or tabs.
+struct VIEWS_EXPORT ForegroundLease {
+  uint64_t window_id = 0;
+  uint64_t target_tab = 0;
+  ForegroundAssistReason reason = ForegroundAssistReason::kOther;
+  base::TimeTicks granted_at;
+  base::TimeTicks expires_at;
+  uint64_t request_seq = 0;
+};
+
+VIEWS_EXPORT const char* ForegroundAssistReasonToString(
+    ForegroundAssistReason reason);
+VIEWS_EXPORT const char* ForegroundAssistRequestResultToString(
+    ForegroundAssistRequestResult result);
+VIEWS_EXPORT const char* ForegroundAssistReleaseReasonToString(
+    ForegroundAssistReleaseReason reason);
+
+// Whether `lease` covers `now` (and names a real window). A lease is live for
+// now in [granted_at, expires_at): at expires_at it is already expired.
+VIEWS_EXPORT bool IsForegroundLeaseActive(const ForegroundLease& lease,
+                                          base::TimeTicks now);
+
+// One request decision: the result plus the stable machine-readable reason
+// used in the BROWSER_CLI_PRESENTATION transition log.
+struct VIEWS_EXPORT ForegroundAssistRequestDecision {
+  ForegroundAssistRequestResult result = ForegroundAssistRequestResult::kDenied;
+  const char* reason = nullptr;
+};
+
+// Pure, ordered decision for one lease request. The order encodes the security
+// requirements and is part of the contract:
+//   1. unmanaged mode denies (stock Chromium has no assist);
+//   2. only the agent origin may ever be granted (fail closed);
+//   3. window_id 0 is an invalid target;
+//   4. a HUMAN-owned target is always denied (invariant 5.3), even while
+//      another lease would also make the request busy;
+//   5. a request for the window that already holds the lease is an idempotent
+//      kGranted that does not extend the deadline;
+//   6. any other live lease makes this request kBusy (single instance).
+// `active_lease_window_id` is 0 when no lease is live; the caller must have
+// lazily released expired leases before calling.
+VIEWS_EXPORT ForegroundAssistRequestDecision
+EvaluateForegroundAssistRequest(bool managed_mode_enabled,
+                                bool requester_is_agent_assist,
+                                uint64_t window_id,
+                                bool target_is_human_owned,
+                                uint64_t active_lease_window_id);
+
+}  // namespace views
+
+#endif  // UI_VIEWS_WIDGET_BROWSER_CLI_FOREGROUND_LEASE_H_
diff --git a/ui/views/widget/browser_cli_foreground_lease_unittest.cc b/ui/views/widget/browser_cli_foreground_lease_unittest.cc
new file mode 100644
index 0000000000..9fcba2fe93
--- /dev/null
+++ b/ui/views/widget/browser_cli_foreground_lease_unittest.cc
@@ -0,0 +1,205 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/views/widget/browser_cli_foreground_lease.h"
+
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace views {
+namespace {
+
+// Pure unit tests for the foreground assist lease vocabulary and the ordered
+// request decision. No policy singleton, no window and no timer is involved.
+
+TEST(BrowserCliForegroundLeaseTest, ReasonStringsAreStable) {
+  EXPECT_STREQ(ForegroundAssistReasonToString(ForegroundAssistReason::kLogin),
+               "login");
+  EXPECT_STREQ(ForegroundAssistReasonToString(ForegroundAssistReason::kCaptcha),
+               "captcha");
+  EXPECT_STREQ(
+      ForegroundAssistReasonToString(ForegroundAssistReason::kConfirmation),
+      "confirmation");
+  EXPECT_STREQ(ForegroundAssistReasonToString(ForegroundAssistReason::kOther),
+               "other");
+}
+
+TEST(BrowserCliForegroundLeaseTest, RequestResultStringsAreStable) {
+  EXPECT_STREQ(ForegroundAssistRequestResultToString(
+                   ForegroundAssistRequestResult::kGranted),
+               "granted");
+  EXPECT_STREQ(ForegroundAssistRequestResultToString(
+                   ForegroundAssistRequestResult::kDenied),
+               "denied");
+  EXPECT_STREQ(ForegroundAssistRequestResultToString(
+                   ForegroundAssistRequestResult::kBusy),
+               "busy");
+  EXPECT_STREQ(ForegroundAssistRequestResultToString(
+                   ForegroundAssistRequestResult::kInvalidTarget),
+               "invalid-target");
+}
+
+TEST(BrowserCliForegroundLeaseTest, ReleaseReasonStringsAreStable) {
+  EXPECT_STREQ(ForegroundAssistReleaseReasonToString(
+                   ForegroundAssistReleaseReason::kAgentRelease),
+               "agent-release");
+  EXPECT_STREQ(ForegroundAssistReleaseReasonToString(
+                   ForegroundAssistReleaseReason::kTimeout),
+               "timeout");
+  EXPECT_STREQ(ForegroundAssistReleaseReasonToString(
+                   ForegroundAssistReleaseReason::kUserTakeover),
+               "user-takeover");
+  EXPECT_STREQ(ForegroundAssistReleaseReasonToString(
+                   ForegroundAssistReleaseReason::kWindowDestroyed),
+               "window-destroyed");
+}
+
+TEST(BrowserCliForegroundLeaseTest, DefaultTtlIsFiveMinutes) {
+  EXPECT_EQ(kDefaultForegroundAssistLeaseTtl, base::Minutes(5));
+}
+
+TEST(BrowserCliForegroundLeaseTest, LeaseIsActiveUntilExpiry) {
+  const base::TimeTicks granted_at = base::TimeTicks() + base::Minutes(100);
+  ForegroundLease lease;
+  lease.window_id = 7;
+  lease.granted_at = granted_at;
+  lease.expires_at = granted_at + base::Minutes(5);
+
+  // Before granted_at the lease does not exist yet: not active.
+  EXPECT_FALSE(
+      IsForegroundLeaseActive(lease, granted_at - base::Milliseconds(1)));
+  // At granted_at the lease is already active (closed lower bound).
+  EXPECT_TRUE(IsForegroundLeaseActive(lease, granted_at));
+  EXPECT_TRUE(IsForegroundLeaseActive(lease, granted_at + base::Minutes(4)));
+  EXPECT_TRUE(
+      IsForegroundLeaseActive(lease, lease.expires_at - base::Milliseconds(1)));
+  // At the deadline the lease is already expired (half-open upper bound).
+  EXPECT_FALSE(IsForegroundLeaseActive(lease, lease.expires_at));
+  EXPECT_FALSE(
+      IsForegroundLeaseActive(lease, lease.expires_at + base::Milliseconds(1)));
+
+  // A lease without a real window id is never active.
+  ForegroundLease unnamed = lease;
+  unnamed.window_id = 0;
+  EXPECT_FALSE(IsForegroundLeaseActive(unnamed, granted_at));
+}
+
+// Explicit interval-boundary regression test for the reviewed contract
+// [granted_at, expires_at): the implementation previously only checked the
+// upper bound, so a time before granted_at wrongly reported active.
+TEST(BrowserCliForegroundLeaseTest, LeaseIntervalBoundariesAreExplicit) {
+  const base::TimeTicks granted_at = base::TimeTicks() + base::Seconds(1000);
+  ForegroundLease lease;
+  lease.window_id = 3;
+  lease.granted_at = granted_at;
+  lease.expires_at = granted_at + base::Seconds(60);
+
+  // 1 ms before granted_at: not active.
+  EXPECT_FALSE(
+      IsForegroundLeaseActive(lease, granted_at - base::Milliseconds(1)));
+  // Exactly at granted_at: active.
+  EXPECT_TRUE(IsForegroundLeaseActive(lease, granted_at));
+  // Exactly at expires_at: not active.
+  EXPECT_FALSE(IsForegroundLeaseActive(lease, lease.expires_at));
+}
+
+// The ordered decision contract: the reason string is part of the log
+// contract, so this pins result and reason for every combination of the five
+// inputs (2 * 2 * 2 * 2 * 3 = 48 cases).
+TEST(BrowserCliForegroundLeaseTest, RequestDecisionIsExhaustiveOverInputs) {
+  struct Expected {
+    ForegroundAssistRequestResult result;
+    const char* reason;
+  };
+  const auto expected_for = [](bool managed_mode_enabled,
+                               bool requester_is_agent_assist,
+                               uint64_t window_id, bool target_is_human_owned,
+                               uint64_t active_lease_window_id) -> Expected {
+    // Mirrors the documented order: unmanaged, origin, invalid target,
+    // HUMAN-owned target, idempotent same-window, busy, granted.
+    if (!managed_mode_enabled) {
+      return {ForegroundAssistRequestResult::kDenied,
+              "unmanaged-stock-behavior"};
+    }
+    if (!requester_is_agent_assist) {
+      return {ForegroundAssistRequestResult::kDenied,
+              "assist-origin-not-agent"};
+    }
+    if (window_id == 0) {
+      return {ForegroundAssistRequestResult::kInvalidTarget,
+              "assist-invalid-target"};
+    }
+    if (target_is_human_owned) {
+      return {ForegroundAssistRequestResult::kDenied,
+              "assist-target-human-owned"};
+    }
+    if (active_lease_window_id == window_id) {
+      return {ForegroundAssistRequestResult::kGranted,
+              "assist-already-granted"};
+    }
+    if (active_lease_window_id != 0) {
+      return {ForegroundAssistRequestResult::kBusy, "assist-busy"};
+    }
+    return {ForegroundAssistRequestResult::kGranted, "assist-granted"};
+  };
+
+  int cases = 0;
+  for (const bool managed : {false, true}) {
+    for (const bool agent : {false, true}) {
+      for (const uint64_t window_id : {uint64_t{0}, uint64_t{7}}) {
+        for (const bool human_owned : {false, true}) {
+          for (const uint64_t active :
+               {uint64_t{0}, uint64_t{7}, uint64_t{9}}) {
+            const Expected expected =
+                expected_for(managed, agent, window_id, human_owned, active);
+            const ForegroundAssistRequestDecision decision =
+                EvaluateForegroundAssistRequest(managed, agent, window_id,
+                                                human_owned, active);
+            EXPECT_EQ(decision.result, expected.result)
+                << "managed=" << managed << " agent=" << agent
+                << " window_id=" << window_id << " human=" << human_owned
+                << " active=" << active;
+            EXPECT_STREQ(decision.reason, expected.reason)
+                << "managed=" << managed << " agent=" << agent
+                << " window_id=" << window_id << " human=" << human_owned
+                << " active=" << active;
+            ++cases;
+          }
+        }
+      }
+    }
+  }
+  EXPECT_EQ(cases, 48);
+}
+
+// Precedence checks for the security-relevant orderings, stated separately
+// from the exhaustive table so a reordering regression fails loudly.
+TEST(BrowserCliForegroundLeaseTest, RequestDecisionPrecedence) {
+  // HUMAN ownership beats busy and grants.
+  ForegroundAssistRequestDecision decision = EvaluateForegroundAssistRequest(
+      /*managed_mode_enabled=*/true, /*requester_is_agent_assist=*/true,
+      /*window_id=*/5, /*target_is_human_owned=*/true,
+      /*active_lease_window_id=*/9);
+  EXPECT_EQ(decision.result, ForegroundAssistRequestResult::kDenied);
+  EXPECT_STREQ(decision.reason, "assist-target-human-owned");
+
+  // Origin validation beats every other denial.
+  decision = EvaluateForegroundAssistRequest(
+      /*managed_mode_enabled=*/true, /*requester_is_agent_assist=*/false,
+      /*window_id=*/0, /*target_is_human_owned=*/true,
+      /*active_lease_window_id=*/9);
+  EXPECT_EQ(decision.result, ForegroundAssistRequestResult::kDenied);
+  EXPECT_STREQ(decision.reason, "assist-origin-not-agent");
+
+  // Unmanaged mode beats every other denial.
+  decision = EvaluateForegroundAssistRequest(
+      /*managed_mode_enabled=*/false, /*requester_is_agent_assist=*/false,
+      /*window_id=*/0, /*target_is_human_owned=*/true,
+      /*active_lease_window_id=*/9);
+  EXPECT_EQ(decision.result, ForegroundAssistRequestResult::kDenied);
+  EXPECT_STREQ(decision.reason, "unmanaged-stock-behavior");
+}
+
+}  // namespace
+}  // namespace views
