+TEST_F(BrowserCliPresentationPolicyTest, AssistWindowDestroyedReleasesLease) {
+  EnableManagedModeAt(TestNow());
+  ASSERT_EQ(RequestAssist(120), ForegroundAssistRequestResult::kGranted);
+
+  policy()->ReleaseForegroundAssist(
+      120, ForegroundAssistReleaseReason::kWindowDestroyed);
+  EXPECT_FALSE(policy()->IsForegroundAssistLeased(120));
+  EXPECT_EQ(policy()->active_foreground_assist_lease_count_for_testing(), 0u);
+  EXPECT_FALSE(Allow(ForegroundOrigin::kAgentAssist,
+                     BrowserCliPresentationAction::kShowAndActivate, 120));
+  EXPECT_EQ(RequestAssist(121), ForegroundAssistRequestResult::kGranted);
+}
