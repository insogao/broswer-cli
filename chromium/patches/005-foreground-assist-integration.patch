diff --git a/chrome/browser/browser_cli/foreground_assist.cc b/chrome/browser/browser_cli/foreground_assist.cc
new file mode 100644
index 0000000000..b12b0e1f03
--- /dev/null
+++ b/chrome/browser/browser_cli/foreground_assist.cc
@@ -0,0 +1,199 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/foreground_assist.h"
+
+#include <optional>
+#include <string>
+
+#include "chrome/browser/browser_cli/user_explicit_show.h"
+#include "chrome/common/chrome_switches.h"
+#include "content/public/common/content_switches.h"
+#include "ui/gfx/switches.h"
+
+namespace browser_cli {
+namespace {
+
+// Strict positive decimal uint64 parsing: no sign, no whitespace, no empty
+// string, no overflow, no zero. Window and tab ids are plain decimal numbers
+// in the producer contract.
+std::optional<uint64_t> ParsePositiveUint64(const std::string& value) {
+  if (value.empty()) {
+    return std::nullopt;
+  }
+  uint64_t result = 0;
+  for (char c : value) {
+    if (c < '0' || c > '9') {
+      return std::nullopt;
+    }
+    const uint64_t digit = static_cast<uint64_t>(c - '0');
+    if (result > (UINT64_MAX - digit) / 10) {
+      return std::nullopt;
+    }
+    result = result * 10 + digit;
+  }
+  if (result == 0) {
+    return std::nullopt;
+  }
+  return result;
+}
+
+std::optional<views::ForegroundAssistReason> ParseReason(
+    const std::string& value) {
+  if (value == "login") {
+    return views::ForegroundAssistReason::kLogin;
+  }
+  if (value == "captcha") {
+    return views::ForegroundAssistReason::kCaptcha;
+  }
+  if (value == "confirmation") {
+    return views::ForegroundAssistReason::kConfirmation;
+  }
+  if (value == "other") {
+    return views::ForegroundAssistReason::kOther;
+  }
+  return std::nullopt;
+}
+
+// Launch switches that must never be granted an assist lease. This is the
+// same fail-closed set the explicit show producer refuses.
+bool HasBlockingLaunchArguments(const base::CommandLine& command_line) {
+  return !command_line.GetArgs().empty() ||
+         command_line.HasSwitch(switches::kApp) ||
+         command_line.HasSwitch(switches::kAppId) ||
+         command_line.HasSwitch(switches::kIncognito) ||
+         command_line.HasSwitch(switches::kEnableAutomation) ||
+         command_line.HasSwitch(switches::kHeadless);
+}
+
+// Whether |switch_name| belongs to the blocked launch-argument set. Used by the
+// cold-start sanitizer to drop exactly the switches the classifier refuses.
+bool IsBlockingLaunchSwitch(const std::string& switch_name) {
+  return switch_name == switches::kApp || switch_name == switches::kAppId ||
+         switch_name == switches::kIncognito ||
+         switch_name == switches::kEnableAutomation ||
+         switch_name == switches::kHeadless;
+}
+
+}  // namespace
+
+bool ForegroundAssistRequestClassConsumesCommandLine(
+    ForegroundAssistRequestClass request_class) {
+  // Any assist intent (valid or blocked) is consumed by the producer; only a
+  // command line without the assist switches may continue as an ordinary
+  // launch.
+  return request_class != ForegroundAssistRequestClass::kNotRequested;
+}
+
+bool HasForegroundAssistIntent(const base::CommandLine& command_line) {
+  return command_line.HasSwitch(kBrowserCliForegroundAssistSwitch) ||
+         command_line.HasSwitch(kBrowserCliForegroundAssistReleaseSwitch);
+}
+
+base::CommandLine CommandLineForColdStartStartup(
+    const base::CommandLine& command_line) {
+  if (!HasForegroundAssistIntent(command_line)) {
+    // Ordinary (non-assist) startup: byte-identical copy, nothing changes.
+    return command_line;
+  }
+  // An assist invocation must never be processed by the ordinary startup as a
+  // URL / app / incognito / automation / headless launch. Copy every switch
+  // except the blocked launch set (positional URL arguments are dropped by
+  // construction) and force background mode, so StartupBrowserCreator only
+  // brings up the process and never opens a window or the profile picker.
+  base::CommandLine sanitized(base::CommandLine::NO_PROGRAM);
+  for (const auto& [name, value] : command_line.GetSwitches()) {
+    if (IsBlockingLaunchSwitch(name)) {
+      continue;
+    }
+    if (value.empty()) {
+      sanitized.AppendSwitch(name);
+    } else {
+      sanitized.AppendSwitchASCII(name, value);
+    }
+  }
+  sanitized.AppendSwitch(switches::kNoStartupWindow);
+  return sanitized;
+}
+
+ForegroundAssistRequestClass ClassifyForegroundAssistRequest(
+    const base::CommandLine& command_line,
+    ForegroundAssistRequest* request) {
+  const bool requests_lease =
+      command_line.HasSwitch(kBrowserCliForegroundAssistSwitch);
+  const bool requests_release =
+      command_line.HasSwitch(kBrowserCliForegroundAssistReleaseSwitch);
+  if (!requests_lease && !requests_release) {
+    return ForegroundAssistRequestClass::kNotRequested;
+  }
+  if (requests_lease && requests_release) {
+    return ForegroundAssistRequestClass::kBlockedByConflictingSwitches;
+  }
+  // A user-explicit show must never be combined with an agent assist request:
+  // the user's action owns the foreground.
+  if (command_line.HasSwitch(kBrowserCliUserExplicitShowSwitch)) {
+    return ForegroundAssistRequestClass::kBlockedByConflictingSwitches;
+  }
+  if (HasBlockingLaunchArguments(command_line)) {
+    return ForegroundAssistRequestClass::kBlockedByLaunchArguments;
+  }
+
+  // Tab-level targeting is not implemented: a present tab switch is rejected
+  // (malformed values as an invalid target, valid non-zero values as an
+  // unsupported target) so a request can never claim a tab was granted.
+  if (command_line.HasSwitch(kBrowserCliForegroundAssistTabSwitch)) {
+    if (!ParsePositiveUint64(command_line.GetSwitchValueASCII(
+            kBrowserCliForegroundAssistTabSwitch))) {
+      return ForegroundAssistRequestClass::kBlockedByInvalidTarget;
+    }
+    return ForegroundAssistRequestClass::kBlockedByUnsupportedTabTarget;
+  }
+
+  // A release only needs a valid target window; an optional reason must still
+  // be one of the fixed vocabulary values.
+  if (requests_release) {
+    if (command_line.HasSwitch(kBrowserCliForegroundAssistReasonSwitch) &&
+        !ParseReason(command_line.GetSwitchValueASCII(
+            kBrowserCliForegroundAssistReasonSwitch))) {
+      return ForegroundAssistRequestClass::kBlockedByInvalidReason;
+    }
+    if (!command_line.HasSwitch(kBrowserCliForegroundAssistWindowSwitch)) {
+      return ForegroundAssistRequestClass::kBlockedByInvalidTarget;
+    }
+    const std::optional<uint64_t> window =
+        ParsePositiveUint64(command_line.GetSwitchValueASCII(
+            kBrowserCliForegroundAssistWindowSwitch));
+    if (!window) {
+      return ForegroundAssistRequestClass::kBlockedByInvalidTarget;
+    }
+    request->target_window = *window;
+    return ForegroundAssistRequestClass::kReleaseLease;
+  }
+
+  // A request needs both a valid reason and a valid target window.
+  if (!command_line.HasSwitch(kBrowserCliForegroundAssistReasonSwitch)) {
+    return ForegroundAssistRequestClass::kBlockedByInvalidReason;
+  }
+  const std::optional<views::ForegroundAssistReason> reason =
+      ParseReason(command_line.GetSwitchValueASCII(
+          kBrowserCliForegroundAssistReasonSwitch));
+  if (!reason) {
+    return ForegroundAssistRequestClass::kBlockedByInvalidReason;
+  }
+  if (!command_line.HasSwitch(kBrowserCliForegroundAssistWindowSwitch)) {
+    return ForegroundAssistRequestClass::kBlockedByInvalidTarget;
+  }
+  const std::optional<uint64_t> window =
+      ParsePositiveUint64(command_line.GetSwitchValueASCII(
+          kBrowserCliForegroundAssistWindowSwitch));
+  if (!window) {
+    return ForegroundAssistRequestClass::kBlockedByInvalidTarget;
+  }
+  request->target_window = *window;
+  request->target_tab = 0;
+  request->reason = *reason;
+  return ForegroundAssistRequestClass::kRequestLease;
+}
+
+}  // namespace browser_cli
diff --git a/chrome/browser/browser_cli/foreground_assist.h b/chrome/browser/browser_cli/foreground_assist.h
new file mode 100644
index 0000000000..787460ae79
--- /dev/null
+++ b/chrome/browser/browser_cli/foreground_assist.h
@@ -0,0 +1,110 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BROWSER_CLI_FOREGROUND_ASSIST_H_
+#define CHROME_BROWSER_BROWSER_CLI_FOREGROUND_ASSIST_H_
+
+#include <stdint.h>
+
+#include "base/command_line.h"
+#include "ui/views/widget/browser_cli_foreground_lease.h"
+
+namespace browser_cli {
+
+// Command-line switches of the Browser CLI agent foreground-assist producer.
+// They are only set by a separately launched Browser CLI binary invocation
+// (cold-start argv or a second invocation forwarded through ProcessSingleton).
+// Renderers, extensions, web pages and browser-internal code never produce
+// them, so a command line carrying them can be attributed to the agent and,
+// after strict validation, request or release a per-window assist lease.
+inline constexpr char kBrowserCliForegroundAssistSwitch[] =
+    "browser-cli-foreground-assist";
+inline constexpr char kBrowserCliForegroundAssistReleaseSwitch[] =
+    "browser-cli-foreground-assist-release";
+inline constexpr char kBrowserCliForegroundAssistReasonSwitch[] =
+    "browser-cli-foreground-assist-reason";
+inline constexpr char kBrowserCliForegroundAssistWindowSwitch[] =
+    "browser-cli-foreground-assist-window";
+inline constexpr char kBrowserCliForegroundAssistTabSwitch[] =
+    "browser-cli-foreground-assist-tab";
+
+// Classification of one command line for the agent foreground-assist producer.
+// Pure, so the cold-start path and the forwarded-notification path share
+// exactly one decision and unit tests need no browser process.
+enum class ForegroundAssistRequestClass {
+  // Neither the request nor the release switch is present.
+  kNotRequested,
+  // A lease request with a valid reason and target window.
+  kRequestLease,
+  // A release request with a valid target window.
+  kReleaseLease,
+  // The command line also launches something (URL, `--app`, `--app-id`,
+  // `--incognito`) or marks an automated (`--enable-automation`) / headless
+  // (`--headless`) launch. Such a command line must never be granted an assist
+  // lease, and it is consumed so it can never act as an ordinary launch either.
+  kBlockedByLaunchArguments,
+  // The reason switch is missing or not one of the fixed vocabulary values.
+  kBlockedByInvalidReason,
+  // The target window is missing, zero or not a plain decimal uint64.
+  kBlockedByInvalidTarget,
+  // A tab switch is present. Tab-level targeting is not implemented in this
+  // slice (the lease only records an audit value and never selects a tab), so
+  // a command line that names a tab is rejected instead of silently pretending
+  // the tab was granted.
+  kBlockedByUnsupportedTabTarget,
+  // Contradictory producers: the request and release switch together, or an
+  // agent assist combined with the user-explicit show switch.
+  kBlockedByConflictingSwitches,
+};
+
+// A validated assist request. Only filled when the classification is
+// kRequestLease or kReleaseLease. target_tab stays 0: the classifier rejects
+// every tab switch (kBlockedByUnsupportedTabTarget), so no request can claim a
+// tab target.
+struct ForegroundAssistRequest {
+  uint64_t target_window = 0;
+  uint64_t target_tab = 0;
+  views::ForegroundAssistReason reason = views::ForegroundAssistReason::kOther;
+};
+
+// Whether a classified command line must be consumed instead of falling
+// through to ordinary command-line processing (which would open a URL / app
+// window or otherwise act as a normal launch). Only kNotRequested returns
+// false; every assist intent, including a blocked one, is consumed and logged
+// by the producer so an agent invocation can never turn into an ordinary
+// launch that changes a HUMAN-owned window or creates a visible window.
+bool ForegroundAssistRequestClassConsumesCommandLine(
+    ForegroundAssistRequestClass request_class);
+
+// Whether |command_line| carries any assist intent (the request or the release
+// switch). Matches exactly the classifier's entry condition: a command line
+// with only the auxiliary assist switches is kNotRequested and has no intent.
+bool HasForegroundAssistIntent(const base::CommandLine& command_line);
+
+// The command line the cold-start startup (`StartupBrowserCreator::Start`) must
+// use:
+//   * without an assist intent: an unchanged copy of |command_line|;
+//   * with an assist intent: a copy with every positional URL argument and the
+//     blocked launch switches (--app / --app-id / --incognito /
+//     --enable-automation / --headless) removed and `--no-startup-window`
+//     added. The ordinary startup then only brings up the browser process
+//     (silent_launch; it never opens a URL, app window or profile picker), and
+//     the assist handler denies and logs the original request.
+// |command_line| itself is never modified. The cold-start call site must pass
+// the returned value to StartupBrowserCreator::Start().
+base::CommandLine CommandLineForColdStartStartup(
+    const base::CommandLine& command_line);
+
+// Classifies |command_line| and, for kRequestLease / kReleaseLease, fills
+// |request|. Everything else fails closed: an assist request can never ride a
+// URL / app / incognito / automated / headless launch, an invalid reason or an
+// invalid target, a tab target (unsupported), and it can never be combined
+// with the user-explicit show switch (the user action owns the foreground).
+ForegroundAssistRequestClass ClassifyForegroundAssistRequest(
+    const base::CommandLine& command_line,
+    ForegroundAssistRequest* request);
+
+}  // namespace browser_cli
+
+#endif  // CHROME_BROWSER_BROWSER_CLI_FOREGROUND_ASSIST_H_
diff --git a/chrome/browser/browser_cli/foreground_assist_controller.cc b/chrome/browser/browser_cli/foreground_assist_controller.cc
new file mode 100644
index 0000000000..0be9e42a46
--- /dev/null
+++ b/chrome/browser/browser_cli/foreground_assist_controller.cc
@@ -0,0 +1,98 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/foreground_assist_controller.h"
+
+#include "base/check.h"
+#include "base/location.h"
+
+namespace browser_cli {
+
+ForegroundAssistController::ForegroundAssistController(
+    Delegate* delegate,
+    base::TimeDelta lease_ttl)
+    : delegate_(delegate), lease_ttl_(lease_ttl) {
+  DCHECK(delegate_);
+  DCHECK_GT(lease_ttl_, base::TimeDelta());
+}
+
+ForegroundAssistController::~ForegroundAssistController() = default;
+
+void ForegroundAssistController::OnLeaseGranted(uint64_t window_id) {
+  DCHECK_NE(window_id, 0u);
+  if (tracked_window_ == window_id) {
+    // Idempotent re-request: keep the original deadline, exactly like the
+    // policy keeps the original lease.
+    return;
+  }
+  // The single lease slot is free again (otherwise the policy would have
+  // answered kBusy), so the previously tracked window must already be hidden
+  // or was never shown; return it to the background before tracking the new
+  // one so no stale assist window can stay visible.
+  FinalizeTrackedWindow();
+  tracked_window_ = window_id;
+  lease_timer_.Start(FROM_HERE, lease_ttl_, this,
+                     &ForegroundAssistController::OnLeaseTimeout);
+}
+
+void ForegroundAssistController::OnLeaseReleasedByAgent(uint64_t window_id) {
+  CancelTrackingForWindow(window_id);
+}
+
+void ForegroundAssistController::OnLeaseReleasedByUserTakeover(
+    uint64_t window_id) {
+  // The policy released the lease for this window before granting HUMAN; the
+  // timer must not survive the takeover, otherwise the original deadline could
+  // hide the window after the user hands it back.
+  CancelTrackingForWindow(window_id);
+}
+
+void ForegroundAssistController::CancelTrackingForWindow(uint64_t window_id) {
+  if (tracked_window_ == 0 || tracked_window_ != window_id) {
+    return;
+  }
+  lease_timer_.Stop();
+  tracked_window_ = 0;
+}
+
+void ForegroundAssistController::OnLeaseTimeout() {
+  const uint64_t window_id = tracked_window_;
+  tracked_window_ = 0;
+  if (window_id == 0) {
+    return;
+  }
+  // The lease was already released (agent release, user takeover, window
+  // destruction) or the window is gone: the timeout must not touch anything.
+  if (!delegate_->WindowExists(window_id)) {
+    return;
+  }
+  // Invariant 5.3: the user's window is never hidden by automation.
+  if (delegate_->WindowIsUserOwned(window_id)) {
+    return;
+  }
+  delegate_->ReleaseLeaseForTimeout(window_id);
+  delegate_->ReturnWindowToBackground(window_id);
+}
+
+void ForegroundAssistController::FinalizeTrackedWindow() {
+  if (tracked_window_ == 0) {
+    return;
+  }
+  const uint64_t previous = tracked_window_;
+  tracked_window_ = 0;
+  lease_timer_.Stop();
+  if (!delegate_->WindowExists(previous)) {
+    return;
+  }
+  if (delegate_->WindowIsUserOwned(previous)) {
+    return;
+  }
+  // The previous lease is already gone from the policy; this release is a
+  // no-op that only guarantees the timeout log exists for the old window if
+  // the lazy sweep has not run yet.
+  delegate_->ReleaseLeaseForTimeout(previous);
+  delegate_->ReturnWindowToBackground(previous);
+}
+
+}  // namespace browser_cli
diff --git a/chrome/browser/browser_cli/foreground_assist_controller.h b/chrome/browser/browser_cli/foreground_assist_controller.h
new file mode 100644
index 0000000000..beae8c9e79
--- /dev/null
+++ b/chrome/browser/browser_cli/foreground_assist_controller.h
@@ -0,0 +1,91 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BROWSER_CLI_FOREGROUND_ASSIST_CONTROLLER_H_
+#define CHROME_BROWSER_BROWSER_CLI_FOREGROUND_ASSIST_CONTROLLER_H_
+
+#include <stdint.h>
+
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+
+namespace browser_cli {
+
+// Browser CLI foreground assist timeout owner (Phase 4 Slice 2).
+//
+// The policy (ui/views) records the single per-window lease and its deadline;
+// this controller owns the only timer that turns an expired lease into a
+// return-to-background for exactly that window. It never decides presentation
+// itself: every effect goes through the Delegate, whose production
+// implementation routes to NativeWidgetMacNSWindowHost (the single
+// presentation gateway). A window the user owns (HUMAN) is never released or
+// hidden by the timeout path, and a lease that was already released (agent
+// release, user takeover, window destruction) makes the timer a no-op.
+//
+// UI-thread only, like the policy.
+class ForegroundAssistController {
+ public:
+  // The effects the controller may cause. Kept free of ui/views types so the
+  // timeout logic is unit-testable without a browser process or a window.
+  class Delegate {
+   public:
+    virtual ~Delegate() = default;
+
+    // Whether a managed window with |window_id| still exists.
+    virtual bool WindowExists(uint64_t window_id) = 0;
+    // Whether the user owns (HUMAN) the window. Never hide such a window.
+    virtual bool WindowIsUserOwned(uint64_t window_id) = 0;
+    // Policy release with reason=timeout. No-op when the lease is already gone
+    // (lazy sweep, agent release, takeover, destruction).
+    virtual void ReleaseLeaseForTimeout(uint64_t window_id) = 0;
+    // Return exactly this window to the background (hide). Never called for a
+    // HUMAN-owned or destroyed window.
+    virtual void ReturnWindowToBackground(uint64_t window_id) = 0;
+  };
+
+  ForegroundAssistController(Delegate* delegate, base::TimeDelta lease_ttl);
+  ForegroundAssistController(const ForegroundAssistController&) = delete;
+  ForegroundAssistController& operator=(const ForegroundAssistController&) =
+      delete;
+  ~ForegroundAssistController();
+
+  // Called after the policy granted a lease for |window_id|. Starts the TTL
+  // timer. An idempotent re-request for the window that is already tracked
+  // keeps the original deadline (the policy does not extend it either). A
+  // grant for a different window first returns the previously tracked window
+  // to the background: the single lease slot was already free, so the previous
+  // window must not stay visible behind the new one.
+  void OnLeaseGranted(uint64_t window_id);
+
+  // Agent-initiated release: the caller performs the policy release and hide;
+  // this only stops the timer so the timeout cannot fire for a lease that is
+  // already gone. Only cancels tracking when |window_id| is the tracked window.
+  void OnLeaseReleasedByAgent(uint64_t window_id);
+
+  // USER_EXPLICIT takeover (ASSIST -> HUMAN): the policy has already released
+  // the lease for |window_id|. Cancel the tracking and the pending timeout
+  // explicitly so the original deadline can never fire for a window the user
+  // owns (or has handed back before the deadline). Only the tracked window is
+  // affected. Callers must invoke this on every USER_EXPLICIT takeover of a
+  // window, not rely on the defensive ownership checks in OnLeaseTimeout().
+  void OnLeaseReleasedByUserTakeover(uint64_t window_id);
+
+  bool IsTrackingWindowForTesting() const { return tracked_window_ != 0; }
+  uint64_t tracked_window_for_testing() const { return tracked_window_; }
+
+ private:
+  void OnLeaseTimeout();
+  void FinalizeTrackedWindow();
+  void CancelTrackingForWindow(uint64_t window_id);
+
+  raw_ptr<Delegate> delegate_;
+  const base::TimeDelta lease_ttl_;
+  base::OneShotTimer lease_timer_;
+  uint64_t tracked_window_ = 0;
+};
+
+}  // namespace browser_cli
+
+#endif  // CHROME_BROWSER_BROWSER_CLI_FOREGROUND_ASSIST_CONTROLLER_H_
diff --git a/chrome/browser/browser_cli/foreground_assist_controller_unittest.cc b/chrome/browser/browser_cli/foreground_assist_controller_unittest.cc
new file mode 100644
index 0000000000..abb2a9f52d
--- /dev/null
+++ b/chrome/browser/browser_cli/foreground_assist_controller_unittest.cc
@@ -0,0 +1,186 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/foreground_assist_controller.h"
+
+#include <set>
+#include <vector>
+
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace browser_cli {
+namespace {
+
+constexpr base::TimeDelta kTestTtl = base::Seconds(30);
+
+class FakeDelegate : public ForegroundAssistController::Delegate {
+ public:
+  bool WindowExists(uint64_t window_id) override {
+    return existing.count(window_id) > 0;
+  }
+  bool WindowIsUserOwned(uint64_t window_id) override {
+    return user_owned.count(window_id) > 0;
+  }
+  void ReleaseLeaseForTimeout(uint64_t window_id) override {
+    released.push_back(window_id);
+  }
+  void ReturnWindowToBackground(uint64_t window_id) override {
+    returned_to_background.push_back(window_id);
+  }
+
+  std::set<uint64_t> existing;
+  std::set<uint64_t> user_owned;
+  std::vector<uint64_t> released;
+  std::vector<uint64_t> returned_to_background;
+};
+
+class ForegroundAssistControllerTest : public testing::Test {
+ protected:
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  FakeDelegate delegate_;
+  ForegroundAssistController controller_{&delegate_, kTestTtl};
+};
+
+TEST_F(ForegroundAssistControllerTest,
+       TimeoutReturnsOnlyTheTrackedWindowToBackground) {
+  delegate_.existing = {7, 8};
+  controller_.OnLeaseGranted(7);
+  EXPECT_TRUE(controller_.IsTrackingWindowForTesting());
+
+  task_environment_.FastForwardBy(kTestTtl - base::Milliseconds(1));
+  EXPECT_TRUE(delegate_.released.empty());
+  EXPECT_TRUE(delegate_.returned_to_background.empty());
+
+  task_environment_.FastForwardBy(base::Milliseconds(1));
+  EXPECT_EQ(delegate_.released, std::vector<uint64_t>({7}));
+  EXPECT_EQ(delegate_.returned_to_background, std::vector<uint64_t>({7}));
+  EXPECT_FALSE(controller_.IsTrackingWindowForTesting());
+
+  // The timeout fires exactly once.
+  task_environment_.FastForwardBy(kTestTtl);
+  EXPECT_EQ(delegate_.released.size(), 1u);
+  EXPECT_EQ(delegate_.returned_to_background.size(), 1u);
+}
+
+TEST_F(ForegroundAssistControllerTest, TimeoutIsNoopForAWindowTheUserOwns) {
+  delegate_.existing = {7};
+  delegate_.user_owned = {7};
+  controller_.OnLeaseGranted(7);
+
+  task_environment_.FastForwardBy(kTestTtl);
+  EXPECT_TRUE(delegate_.released.empty());
+  EXPECT_TRUE(delegate_.returned_to_background.empty());
+  EXPECT_FALSE(controller_.IsTrackingWindowForTesting());
+}
+
+TEST_F(ForegroundAssistControllerTest, TimeoutIsNoopForADestroyedWindow) {
+  // No window exists: destruction already released the lease and hid nothing.
+  controller_.OnLeaseGranted(7);
+
+  task_environment_.FastForwardBy(kTestTtl);
+  EXPECT_TRUE(delegate_.released.empty());
+  EXPECT_TRUE(delegate_.returned_to_background.empty());
+  EXPECT_FALSE(controller_.IsTrackingWindowForTesting());
+}
+
+TEST_F(ForegroundAssistControllerTest,
+       NewGrantFinalizesThePreviouslyTrackedWindow) {
+  delegate_.existing = {7, 8};
+  controller_.OnLeaseGranted(7);
+  task_environment_.FastForwardBy(base::Milliseconds(5));
+
+  // The single lease slot was already free for window 8, so window 7 must be
+  // returned to the background before window 8 is tracked.
+  controller_.OnLeaseGranted(8);
+  EXPECT_EQ(delegate_.released, std::vector<uint64_t>({7}));
+  EXPECT_EQ(delegate_.returned_to_background, std::vector<uint64_t>({7}));
+  EXPECT_EQ(controller_.tracked_window_for_testing(), 8u);
+
+  task_environment_.FastForwardBy(kTestTtl);
+  EXPECT_EQ(delegate_.released, std::vector<uint64_t>({7, 8}));
+  EXPECT_EQ(delegate_.returned_to_background, std::vector<uint64_t>({7, 8}));
+}
+
+TEST_F(ForegroundAssistControllerTest,
+       AgentReleaseStopsTheTimerWithoutTouchingTheWindow) {
+  delegate_.existing = {7};
+  controller_.OnLeaseGranted(7);
+  controller_.OnLeaseReleasedByAgent(7);
+  EXPECT_FALSE(controller_.IsTrackingWindowForTesting());
+
+  // The agent release path performs the policy release and hide itself; the
+  // timeout must not repeat either effect.
+  task_environment_.FastForwardBy(kTestTtl * 2);
+  EXPECT_TRUE(delegate_.released.empty());
+  EXPECT_TRUE(delegate_.returned_to_background.empty());
+}
+
+TEST_F(ForegroundAssistControllerTest,
+       AgentReleaseForAnotherWindowKeepsTracking) {
+  delegate_.existing = {7, 8};
+  controller_.OnLeaseGranted(7);
+  controller_.OnLeaseReleasedByAgent(8);
+
+  EXPECT_TRUE(controller_.IsTrackingWindowForTesting());
+  task_environment_.FastForwardBy(kTestTtl);
+  EXPECT_EQ(delegate_.released, std::vector<uint64_t>({7}));
+  EXPECT_EQ(delegate_.returned_to_background, std::vector<uint64_t>({7}));
+}
+
+// ASSIST -> HUMAN: the takeover cancels the pending timeout explicitly. Without
+// this, a user who hands the window back before the original deadline would
+// have the stale timer hide the window.
+TEST_F(ForegroundAssistControllerTest, UserTakeoverCancelsThePendingTimeout) {
+  delegate_.existing = {7};
+  controller_.OnLeaseGranted(7);
+  controller_.OnLeaseReleasedByUserTakeover(7);
+  EXPECT_FALSE(controller_.IsTrackingWindowForTesting());
+
+  // The user hands the window back (no longer user-owned), then the original
+  // deadline passes: nothing may be released or hidden.
+  delegate_.user_owned.clear();
+  task_environment_.FastForwardBy(kTestTtl * 2);
+  EXPECT_TRUE(delegate_.released.empty());
+  EXPECT_TRUE(delegate_.returned_to_background.empty());
+}
+
+TEST_F(ForegroundAssistControllerTest,
+       UserTakeoverForAnotherWindowKeepsTracking) {
+  delegate_.existing = {7, 8};
+  controller_.OnLeaseGranted(7);
+  controller_.OnLeaseReleasedByUserTakeover(8);
+  EXPECT_TRUE(controller_.IsTrackingWindowForTesting());
+
+  task_environment_.FastForwardBy(kTestTtl);
+  EXPECT_EQ(delegate_.released, std::vector<uint64_t>({7}));
+  EXPECT_EQ(delegate_.returned_to_background, std::vector<uint64_t>({7}));
+}
+
+TEST_F(ForegroundAssistControllerTest,
+       IdempotentGrantKeepsTheOriginalDeadline) {
+  delegate_.existing = {7};
+  controller_.OnLeaseGranted(7);
+  task_environment_.FastForwardBy(kTestTtl / 2);
+  controller_.OnLeaseGranted(7);
+
+  // Half a TTL is left; a restarted timer would still be pending here.
+  task_environment_.FastForwardBy(kTestTtl / 2);
+  EXPECT_EQ(delegate_.released, std::vector<uint64_t>({7}));
+  EXPECT_EQ(delegate_.returned_to_background, std::vector<uint64_t>({7}));
+}
+
+TEST_F(ForegroundAssistControllerTest, TimeoutNeverTouchesOtherWindows) {
+  delegate_.existing = {7, 8, 9};
+  controller_.OnLeaseGranted(8);
+  task_environment_.FastForwardBy(kTestTtl);
+
+  EXPECT_EQ(delegate_.released, std::vector<uint64_t>({8}));
+  EXPECT_EQ(delegate_.returned_to_background, std::vector<uint64_t>({8}));
+}
+
+}  // namespace
+}  // namespace browser_cli
diff --git a/chrome/browser/browser_cli/foreground_assist_presentation.h b/chrome/browser/browser_cli/foreground_assist_presentation.h
new file mode 100644
index 0000000000..5017b6e442
--- /dev/null
+++ b/chrome/browser/browser_cli/foreground_assist_presentation.h
@@ -0,0 +1,46 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BROWSER_CLI_FOREGROUND_ASSIST_PRESENTATION_H_
+#define CHROME_BROWSER_BROWSER_CLI_FOREGROUND_ASSIST_PRESENTATION_H_
+
+#include "base/command_line.h"
+#include "chrome/browser/browser_cli/foreground_assist_controller.h"
+
+namespace browser_cli {
+
+// Browser CLI agent foreground-assist producer (macOS). Handles a command line
+// that may carry the request or release switches from either the cold-start
+// path or a forwarded ProcessSingleton notification.
+//
+// The producer never presents anything by itself: it strictly classifies the
+// command line (fail closed on launch arguments, invalid reason or target,
+// unsupported tab targets, and conflicting producer switches), asks the
+// presentation policy for the lease through NativeWidgetMacNSWindowHost, and
+// only presents the target window after the policy granted the lease. The
+// target must be a top-level BrowserWindow; child widgets, bubbles and other
+// non-window widgets fail closed. A HUMAN-owned window is never a valid target,
+// the release path only touches a lease that matches the requested window, and
+// the timeout timer returns exactly the leased window to the background (never
+// a HUMAN-owned one).
+//
+// Returns true when the assist intent was consumed: a lease was granted and the
+// window presented, a release was handled or denied, or the request was
+// rejected / failed with a structured producer log. Returns false only when the
+// command line carries no assist switch at all (kNotRequested). Every blocked
+// classification is consumed, so an assist invocation can never fall through to
+// ordinary command-line processing and act as a URL / app / incognito launch
+// that could change a HUMAN-owned window or create a visible window.
+bool HandleForegroundAssistRequest(const base::CommandLine& command_line);
+
+// The process-wide controller that owns the single assist timeout timer. The
+// USER_EXPLICIT presentation path calls
+// OnLeaseReleasedByUserTakeover(window_id) so an ASSIST -> HUMAN takeover
+// cancels the pending timeout and the original deadline can never hide a window
+// the user owns (or has handed back).
+ForegroundAssistController* GetForegroundAssistController();
+
+}  // namespace browser_cli
+
+#endif  // CHROME_BROWSER_BROWSER_CLI_FOREGROUND_ASSIST_PRESENTATION_H_
diff --git a/chrome/browser/browser_cli/foreground_assist_presentation.mm b/chrome/browser/browser_cli/foreground_assist_presentation.mm
new file mode 100644
index 0000000000..64a6825a3f
--- /dev/null
+++ b/chrome/browser/browser_cli/foreground_assist_presentation.mm
@@ -0,0 +1,228 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/foreground_assist_presentation.h"
+
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/notreached.h"
+#include "chrome/browser/browser_cli/foreground_assist.h"
+#include "chrome/browser/browser_cli/foreground_assist_controller.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "ui/views/cocoa/native_widget_mac_ns_window_host.h"
+#include "ui/views/widget/widget.h"
+
+namespace browser_cli {
+namespace {
+
+// Structured producer log. `result` is handled / denied / failed / noop and
+// `reason` is the stable machine-readable outcome; the presentation policy and
+// the host add their own BROWSER_CLI_PRESENTATION logs for every actual
+// request, so a producer outcome can always be correlated with a grant / deny
+// / busy / timeout / release decision.
+void LogProducerOutcome(const char* result,
+                        const char* reason,
+                        bool managed_mode,
+                        uint64_t window_id,
+                        const char* lease_reason) {
+  LOG(INFO) << "BROWSER_CLI_FOREGROUND_ASSIST stage=producer"
+            << " result=" << result << " reason=" << reason
+            << " window_id=" << window_id << " lease_reason=" << lease_reason
+            << " managed=" << (managed_mode ? "yes" : "no");
+}
+
+// Routes the controller's effects to the single presentation gateway. Every
+// call re-resolves the host by id, so a destroyed window can never be touched
+// and a new window that reuses the id cannot inherit the lease (the policy
+// releases the lease on destruction).
+class HostForegroundAssistDelegate
+    : public ForegroundAssistController::Delegate {
+ public:
+  bool WindowExists(uint64_t window_id) override {
+    return views::NativeWidgetMacNSWindowHost::GetFromWidgetId(window_id) !=
+           nullptr;
+  }
+
+  bool WindowIsUserOwned(uint64_t window_id) override {
+    views::NativeWidgetMacNSWindowHost* host =
+        views::NativeWidgetMacNSWindowHost::GetFromWidgetId(window_id);
+    return host && host->IsUserExplicitOwned();
+  }
+
+  void ReleaseLeaseForTimeout(uint64_t window_id) override {
+    views::NativeWidgetMacNSWindowHost* host =
+        views::NativeWidgetMacNSWindowHost::GetFromWidgetId(window_id);
+    if (host) {
+      host->ReleaseForegroundAssistLease(
+          views::ForegroundAssistReleaseReason::kTimeout);
+    }
+  }
+
+  void ReturnWindowToBackground(uint64_t window_id) override {
+    views::NativeWidgetMacNSWindowHost* host =
+        views::NativeWidgetMacNSWindowHost::GetFromWidgetId(window_id);
+    if (host) {
+      host->HideForForegroundAssistRelease();
+    }
+  }
+};
+
+ForegroundAssistController* GetController() {
+  static base::NoDestructor<HostForegroundAssistDelegate> delegate;
+  static base::NoDestructor<ForegroundAssistController> controller(
+      delegate.get(), views::kDefaultForegroundAssistLeaseTtl);
+  return controller.get();
+}
+
+// Whether |host| is a top-level widget that belongs to a real BrowserWindow.
+// The host check rejects child widgets / bubbles / menus; the collection lookup
+// rejects top-level widgets that are not browser windows (for example dialogs).
+bool IsTopLevelBrowserWindow(views::NativeWidgetMacNSWindowHost* host) {
+  if (!host || !host->IsEligibleForegroundAssistTarget()) {
+    return false;
+  }
+  views::Widget* widget = host->GetWidget();
+  GlobalBrowserCollection* collection = GlobalBrowserCollection::GetInstance();
+  return widget && collection &&
+         collection->FindBrowserWithWindow(widget->GetNativeWindow()) !=
+             nullptr;
+}
+
+}  // namespace
+
+ForegroundAssistController* GetForegroundAssistController() {
+  return GetController();
+}
+
+bool HandleForegroundAssistRequest(const base::CommandLine& command_line) {
+  ForegroundAssistRequest request;
+  const ForegroundAssistRequestClass request_class =
+      ClassifyForegroundAssistRequest(command_line, &request);
+  if (!ForegroundAssistRequestClassConsumesCommandLine(request_class)) {
+    // No assist switch: ordinary command-line processing continues.
+    return false;
+  }
+
+  const bool managed_mode = views::NativeWidgetMacNSWindowHost::
+      IsBrowserCliManagedPresentationEnabled();
+  const char* lease_reason =
+      views::ForegroundAssistReasonToString(request.reason);
+
+  switch (request_class) {
+    case ForegroundAssistRequestClass::kBlockedByLaunchArguments:
+      // An assist invocation must never act as an ordinary URL / app /
+      // incognito / automation / headless launch: it is consumed here so the
+      // caller cannot fall through to normal command-line processing that might
+      // change a HUMAN-owned window or create a visible window.
+      LogProducerOutcome("denied", "launch-arguments-not-agent-assist",
+                         managed_mode, request.target_window, lease_reason);
+      return true;
+    case ForegroundAssistRequestClass::kBlockedByUnsupportedTabTarget:
+      // Tab-level targeting is not implemented; reject instead of pretending
+      // the named tab was granted.
+      LogProducerOutcome("denied", "unsupported-tab-target", managed_mode,
+                         request.target_window, lease_reason);
+      return true;
+    case ForegroundAssistRequestClass::kBlockedByConflictingSwitches:
+      LogProducerOutcome("denied", "conflicting-producer-switches",
+                         managed_mode, request.target_window, lease_reason);
+      return true;
+    case ForegroundAssistRequestClass::kBlockedByInvalidReason:
+      LogProducerOutcome("denied", "invalid-reason", managed_mode,
+                         request.target_window, lease_reason);
+      return true;
+    case ForegroundAssistRequestClass::kBlockedByInvalidTarget:
+      LogProducerOutcome("denied", "invalid-target", managed_mode,
+                         request.target_window, lease_reason);
+      return true;
+    case ForegroundAssistRequestClass::kNotRequested:
+      return false;
+    case ForegroundAssistRequestClass::kRequestLease:
+    case ForegroundAssistRequestClass::kReleaseLease:
+      break;
+  }
+
+  if (!managed_mode) {
+    // Stock Chromium has no assist: fail closed, present nothing.
+    LogProducerOutcome("noop", "unmanaged-stock-behavior", managed_mode,
+                       request.target_window, lease_reason);
+    return true;
+  }
+
+  views::NativeWidgetMacNSWindowHost* host =
+      views::NativeWidgetMacNSWindowHost::GetFromWidgetId(
+          request.target_window);
+  if (!host) {
+    LogProducerOutcome("denied", "target-window-not-found", managed_mode,
+                       request.target_window, lease_reason);
+    return true;
+  }
+  // Only a top-level BrowserWindow may be named: child widgets, bubbles, menus
+  // and non-browser top-level windows (for example dialogs) fail closed.
+  if (!IsTopLevelBrowserWindow(host)) {
+    LogProducerOutcome("denied", "target-not-top-level-browser-window",
+                       managed_mode, request.target_window, lease_reason);
+    return true;
+  }
+
+  if (request_class == ForegroundAssistRequestClass::kRequestLease) {
+    // Invariant 5.3: a window the user owns is never a valid assist target.
+    if (host->IsUserExplicitOwned()) {
+      LogProducerOutcome("denied", "target-human-owned", managed_mode,
+                         request.target_window, lease_reason);
+      return true;
+    }
+    switch (host->RequestForegroundAssistLease(request.target_tab,
+                                               request.reason)) {
+      case views::ForegroundAssistRequestResult::kGranted:
+        // Only a granted lease may present the window, through the single
+        // visibility gateway (kAgentAssist is checked by the policy again).
+        if (!host->PresentForAgentAssistAction()) {
+          // A lease must not outlive a failed presentation.
+          host->ReleaseForegroundAssistLease(
+              views::ForegroundAssistReleaseReason::kAgentRelease);
+          LogProducerOutcome("failed", "presentation-denied", managed_mode,
+                             request.target_window, lease_reason);
+          return true;
+        }
+        GetController()->OnLeaseGranted(request.target_window);
+        LogProducerOutcome("handled", "lease-granted-and-presented",
+                           managed_mode, request.target_window, lease_reason);
+        return true;
+      case views::ForegroundAssistRequestResult::kDenied:
+        LogProducerOutcome("denied", "lease-denied", managed_mode,
+                           request.target_window, lease_reason);
+        return true;
+      case views::ForegroundAssistRequestResult::kBusy:
+        LogProducerOutcome("denied", "lease-busy", managed_mode,
+                           request.target_window, lease_reason);
+        return true;
+      case views::ForegroundAssistRequestResult::kInvalidTarget:
+        LogProducerOutcome("denied", "invalid-target", managed_mode,
+                           request.target_window, lease_reason);
+        return true;
+    }
+    NOTREACHED();
+  }
+
+  // Release path: only a lease that matches the requested window is touched.
+  if (!host->IsForegroundAssistLeased()) {
+    LogProducerOutcome("denied", "no-matching-lease", managed_mode,
+                       request.target_window, lease_reason);
+    return true;
+  }
+  host->ReleaseForegroundAssistLease(
+      views::ForegroundAssistReleaseReason::kAgentRelease);
+  GetController()->OnLeaseReleasedByAgent(request.target_window);
+  // Never hide a window the user has taken over.
+  if (!host->IsUserExplicitOwned()) {
+    host->HideForForegroundAssistRelease();
+  }
+  LogProducerOutcome("handled", "lease-released", managed_mode,
+                     request.target_window, lease_reason);
+  return true;
+}
+
+}  // namespace browser_cli
diff --git a/chrome/browser/browser_cli/foreground_assist_unittest.cc b/chrome/browser/browser_cli/foreground_assist_unittest.cc
new file mode 100644
index 0000000000..bb77ba6a60
--- /dev/null
+++ b/chrome/browser/browser_cli/foreground_assist_unittest.cc
@@ -0,0 +1,313 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/foreground_assist.h"
+
+#include <string>
+
+#include "base/command_line.h"
+#include "chrome/browser/browser_cli/user_explicit_show.h"
+#include "chrome/common/chrome_switches.h"
+#include "content/public/common/content_switches.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/switches.h"
+
+namespace browser_cli {
+namespace {
+
+base::CommandLine RequestCommandLine(const std::string& reason = "login",
+                                     const std::string& window = "42") {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  command_line.AppendSwitch(kBrowserCliForegroundAssistSwitch);
+  if (!reason.empty()) {
+    command_line.AppendSwitchASCII(kBrowserCliForegroundAssistReasonSwitch,
+                                   reason);
+  }
+  if (!window.empty()) {
+    command_line.AppendSwitchASCII(kBrowserCliForegroundAssistWindowSwitch,
+                                   window);
+  }
+  return command_line;
+}
+
+base::CommandLine ReleaseCommandLine(const std::string& window = "42") {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  command_line.AppendSwitch(kBrowserCliForegroundAssistReleaseSwitch);
+  if (!window.empty()) {
+    command_line.AppendSwitchASCII(kBrowserCliForegroundAssistWindowSwitch,
+                                   window);
+  }
+  return command_line;
+}
+
+TEST(ForegroundAssistRequestTest, NoSwitchIsNotRequested) {
+  const base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  ForegroundAssistRequest request;
+  EXPECT_EQ(ClassifyForegroundAssistRequest(command_line, &request),
+            ForegroundAssistRequestClass::kNotRequested);
+}
+
+TEST(ForegroundAssistRequestTest, ValidRequestParsesReasonAndWindow) {
+  base::CommandLine command_line = RequestCommandLine("captcha", "77");
+  ForegroundAssistRequest request;
+  EXPECT_EQ(ClassifyForegroundAssistRequest(command_line, &request),
+            ForegroundAssistRequestClass::kRequestLease);
+  EXPECT_EQ(request.target_window, 77u);
+  EXPECT_EQ(request.target_tab, 0u);
+  EXPECT_EQ(request.reason, views::ForegroundAssistReason::kCaptcha);
+}
+
+// Tab-level targeting is not implemented: any tab switch is rejected instead of
+// silently pretending the named tab was granted.
+TEST(ForegroundAssistRequestTest, TabTargetIsRejectedAsUnsupported) {
+  {
+    base::CommandLine command_line = RequestCommandLine("login", "42");
+    command_line.AppendSwitchASCII(kBrowserCliForegroundAssistTabSwitch, "9");
+    ForegroundAssistRequest request;
+    EXPECT_EQ(ClassifyForegroundAssistRequest(command_line, &request),
+              ForegroundAssistRequestClass::kBlockedByUnsupportedTabTarget);
+  }
+  {
+    base::CommandLine command_line = ReleaseCommandLine("42");
+    command_line.AppendSwitchASCII(kBrowserCliForegroundAssistTabSwitch, "9");
+    ForegroundAssistRequest request;
+    EXPECT_EQ(ClassifyForegroundAssistRequest(command_line, &request),
+              ForegroundAssistRequestClass::kBlockedByUnsupportedTabTarget);
+  }
+  // A malformed tab value (including zero) stays an invalid target.
+  {
+    base::CommandLine command_line = RequestCommandLine("login", "42");
+    command_line.AppendSwitchASCII(kBrowserCliForegroundAssistTabSwitch, "0");
+    ForegroundAssistRequest request;
+    EXPECT_EQ(ClassifyForegroundAssistRequest(command_line, &request),
+              ForegroundAssistRequestClass::kBlockedByInvalidTarget);
+  }
+}
+
+// Every assist intent (valid or blocked) must be consumed so it can never fall
+// through to ordinary command-line processing and act as a URL / app launch.
+TEST(ForegroundAssistRequestTest, OnlyNotRequestedFallsThrough) {
+  EXPECT_FALSE(ForegroundAssistRequestClassConsumesCommandLine(
+      ForegroundAssistRequestClass::kNotRequested));
+  const ForegroundAssistRequestClass consumed[] = {
+      ForegroundAssistRequestClass::kRequestLease,
+      ForegroundAssistRequestClass::kReleaseLease,
+      ForegroundAssistRequestClass::kBlockedByLaunchArguments,
+      ForegroundAssistRequestClass::kBlockedByInvalidReason,
+      ForegroundAssistRequestClass::kBlockedByInvalidTarget,
+      ForegroundAssistRequestClass::kBlockedByUnsupportedTabTarget,
+      ForegroundAssistRequestClass::kBlockedByConflictingSwitches};
+  for (ForegroundAssistRequestClass request_class : consumed) {
+    EXPECT_TRUE(ForegroundAssistRequestClassConsumesCommandLine(request_class))
+        << "class=" << static_cast<int>(request_class);
+  }
+}
+
+TEST(ForegroundAssistRequestTest, IntentDetectionMatchesProducerSwitches) {
+  EXPECT_FALSE(HasForegroundAssistIntent(
+      base::CommandLine(base::CommandLine::NO_PROGRAM)));
+
+  base::CommandLine release(base::CommandLine::NO_PROGRAM);
+  release.AppendSwitch(kBrowserCliForegroundAssistReleaseSwitch);
+  EXPECT_TRUE(HasForegroundAssistIntent(release));
+
+  // Auxiliary switches alone carry no assist intent.
+  base::CommandLine auxiliary(base::CommandLine::NO_PROGRAM);
+  auxiliary.AppendSwitchASCII(kBrowserCliForegroundAssistWindowSwitch, "42");
+  EXPECT_FALSE(HasForegroundAssistIntent(auxiliary));
+}
+
+// Cold start: without an assist intent the launch command line is
+// byte-identical (nothing changes for ordinary launches or the USER_EXPLICIT
+// show path).
+TEST(ForegroundAssistRequestTest, ColdStartLaunchWithoutIntentIsUnchanged) {
+  base::CommandLine original(base::CommandLine::NO_PROGRAM);
+  original.AppendSwitchASCII("user-data-dir", "/tmp/browser-cli-profile");
+  original.AppendArg("https://example.com/");
+
+  const base::CommandLine launch = CommandLineForColdStartStartup(original);
+  EXPECT_FALSE(launch.HasSwitch(switches::kNoStartupWindow));
+  ASSERT_EQ(launch.GetArgs().size(), 1u);
+  EXPECT_EQ(launch.GetArgs()[0], "https://example.com/");
+  EXPECT_TRUE(launch.HasSwitch("user-data-dir"));
+  // The process command line itself is never modified.
+  EXPECT_FALSE(original.HasSwitch(switches::kNoStartupWindow));
+  EXPECT_EQ(original.GetArgs().size(), 1u);
+}
+
+// Cold start: an assist intent must not reach the ordinary startup as a URL /
+// app / incognito / automation / headless launch. The effective launch command
+// line drops all of those and forces background mode; everything else (profile
+// and Browser CLI flags) survives, and the original request is still classified
+// as blocked so the producer denies and logs it.
+TEST(ForegroundAssistRequestTest, ColdStartLaunchDropsLaunchSideEffects) {
+  base::CommandLine original(base::CommandLine::NO_PROGRAM);
+  original.AppendSwitch(kBrowserCliForegroundAssistSwitch);
+  original.AppendSwitchASCII(kBrowserCliForegroundAssistReasonSwitch, "login");
+  original.AppendSwitchASCII(kBrowserCliForegroundAssistWindowSwitch, "42");
+  original.AppendSwitchASCII("user-data-dir", "/tmp/browser-cli-profile");
+  original.AppendSwitchASCII("profile-directory", "Default");
+  original.AppendSwitch("browser-cli-background-presentation");
+  original.AppendArg("https://example.com/");
+  original.AppendSwitchASCII(switches::kApp, "https://app.example/");
+  original.AppendSwitch(switches::kIncognito);
+  original.AppendSwitch(switches::kEnableAutomation);
+  original.AppendSwitch(switches::kHeadless);
+
+  const base::CommandLine launch = CommandLineForColdStartStartup(original);
+  EXPECT_TRUE(launch.HasSwitch(switches::kNoStartupWindow));
+  EXPECT_TRUE(launch.GetArgs().empty());
+  EXPECT_FALSE(launch.HasSwitch(switches::kApp));
+  EXPECT_FALSE(launch.HasSwitch(switches::kAppId));
+  EXPECT_FALSE(launch.HasSwitch(switches::kIncognito));
+  EXPECT_FALSE(launch.HasSwitch(switches::kEnableAutomation));
+  EXPECT_FALSE(launch.HasSwitch(switches::kHeadless));
+  EXPECT_TRUE(launch.HasSwitch("user-data-dir"));
+  EXPECT_TRUE(launch.HasSwitch("profile-directory"));
+  EXPECT_TRUE(launch.HasSwitch("browser-cli-background-presentation"));
+  EXPECT_TRUE(launch.HasSwitch(kBrowserCliForegroundAssistSwitch));
+
+  // The original still carries the launch arguments and classifies as blocked;
+  // the sanitized startup line is no longer a blocked launch.
+  ForegroundAssistRequest request;
+  EXPECT_EQ(ClassifyForegroundAssistRequest(original, &request),
+            ForegroundAssistRequestClass::kBlockedByLaunchArguments);
+  ASSERT_EQ(original.GetArgs().size(), 1u);
+  EXPECT_EQ(ClassifyForegroundAssistRequest(launch, &request),
+            ForegroundAssistRequestClass::kRequestLease);
+}
