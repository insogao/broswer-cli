+  // Browser CLI: structured observation of this one reopen request. The trace
+  // records the reopen-enter boundary and follows the request through the
+  // Browser CLI-specific branches below (reused existing window vs. new window
+  // through RunInLastProfileSafely -> CreateBrowser -> explicit presentation).
+  // It only observes: no window is shown, hidden or activated by the logging,
+  // and only -applicationShouldHandleReopen: (a real Dock / Launchpad / app
+  // reopen) is traced, never -applicationDidBecomeActive.
+  const bool browser_cli_managed = views::NativeWidgetMacNSWindowHost::
+      IsBrowserCliManagedPresentationEnabled();
+  const std::string browser_cli_reopen_request_id =
+      NewBrowserCliDockReopenRequestId();
+  const base::TimeTicks browser_cli_reopen_start = base::TimeTicks::Now();
+  LogBrowserCliDockReopenBoundary(browser_cli_reopen_request_id,
+                                  browser_cli_reopen_start, "reopen-enter",
+                                  "none", "started", browser_cli_managed);
+
   // Browser CLI: clicking the Dock icon / Launchpad / the app icon is an
   // explicit user request for the browser and must always win over the
   // background-presentation policy (development plan invariant 5.2).
@@ -1883,6 +1935,10 @@ - (BOOL)applicationShouldHandleReopen:(NSApplication*)theApplication
