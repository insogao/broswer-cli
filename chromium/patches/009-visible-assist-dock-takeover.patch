     base::span<const ReopenWindowCandidate> candidates);
 
+// One candidate for the app-reopen *focus* scan, in back-to-front order (the
+// reverse of -[NSApplication orderedWindows]). The macOS app controller fills
+// these fields from AppKit; the pure scan below decides which window the
+// upstream focus path would activate.
+struct ReopenFocusCandidate {
+  bool is_miniaturized = false;
+  bool is_visible = false;
+  bool is_on_active_space = false;
+};
+
+// Returned when the focus scan finds no focusable window (every candidate is
+// hidden and not miniaturized).
+inline constexpr size_t kNoReopenFocusCandidate = static_cast<size_t>(-1);
+
+// Chooses the window the explicit Dock / app-reopen focus path activates:
+//   1. the frontmost candidate (the last in back-to-front order) that is
+//      visible and on the active space wins;
+//   2. when every candidate is miniaturized, the frontmost miniaturized
+//      candidate is selected (the caller deminiaturizes it);
+//   3. hidden, non-miniaturized candidates are never selected, and a visible
+//      candidate on another space never falls back to a miniaturized one.
+//
+// This mirrors FocusWindowSetOnCurrentSpace() in app_controller_mac.mm exactly;
+// the AppKit side effects (intermediate orderFront: raises, final
+// deminiaturize / makeKeyAndOrderFront) stay in the caller. Pure function by
+// design, so the selection is deterministic and unit-testable without windows.
+size_t SelectReopenFocusCandidate(
+    base::span<const ReopenFocusCandidate> candidates);
+
+// One candidate for the managed Dock / app-reopen decision: the focus-scan
+// fields plus the policy/host window id of the browser window (0 when the
+// window has no resolvable managed host and therefore cannot be attributed).
+struct ManagedDockReopenCandidate {
+  ReopenFocusCandidate focus;
+  uint64_t window_id = 0;
+};
+
+// Presents |window_id| through the single per-window USER_EXPLICIT presentation
+// gateway and returns whether the presentation was applied. This callback is
+// the only way HandleManagedDockReopen() can make a window visible or active;
+// the decision helper never touches AppKit itself.
+using ManagedDockPresentCallback = base::RepeatingCallback<bool(uint64_t)>;
+
+enum class ManagedDockReopenOutcome {
+  // The gateway presented the single selected window; the Dock request is
+  // consumed and nothing else may be activated for it.
+  kPresented,
+  // No focusable target (all browser windows hidden) or no resolvable window
+  // id, or the gateway refused/failed. The caller must not activate anything
+  // directly and must continue through the USER_EXPLICIT-gated reuse/create
+  // fallback.
+  kNotPresented,
+};
+
+struct ManagedDockReopenResult {
+  ManagedDockReopenOutcome outcome = ManagedDockReopenOutcome::kNotPresented;
+  // The selected target, or 0 when no focusable candidate existed. It is the
+  // exact window id the gateway was (or would have been) called with: the
+  // window that becomes HUMAN is always this one id, never a second selection.
+  uint64_t target_window_id = 0;
+};
+
+// Managed Dock decision (P0 visible-ASSIST Dock takeover):
+//   1. selects the target exactly once with the same rules as the upstream
+//      focus path (SelectReopenFocusCandidate) and no AppKit side effects;
+//   2. calls |present| exactly once, and only for that target's window id;
+//   3. reports kPresented only when the gateway applied the presentation, and
+//      kNotPresented otherwise (hidden set, unresolvable target, or a gateway
+//      denial), in which case the caller must not activate the target and must
+//      use the gated fallback path.
+//
+// Pure w.r.t. AppKit (the only effect is the callback), so the decision and the
+// "presented exactly once / never activated on failure" contract are
+// unit-testable without creating any window.
+ManagedDockReopenResult HandleManagedDockReopen(
+    base::span<const ManagedDockReopenCandidate> candidates,
+    const ManagedDockPresentCallback& present);
+
 }  // namespace browser_cli
 
 #endif  // CHROME_BROWSER_BROWSER_CLI_REOPEN_WINDOW_SELECTION_H_
