+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/reopen_window_selection.h"
+
+namespace browser_cli {
+
+size_t SelectReopenWindowCandidate(
+    base::span<const ReopenWindowCandidate> candidates) {
+  size_t most_recent_reusable = kNoReopenWindow;
+  size_t most_recent_user_owned = kNoReopenWindow;
+  for (size_t index = 0; index < candidates.size(); ++index) {
+    const ReopenWindowCandidate& candidate = candidates[index];
+    if (!candidate.is_reusable_browser_window) {
+      continue;
+    }
+    // Candidates arrive in creation order, so a later index is more recent.
+    most_recent_reusable = index;
+    if (candidate.is_user_owned) {
+      most_recent_user_owned = index;
+    }
+  }
+  return most_recent_user_owned != kNoReopenWindow ? most_recent_user_owned
+                                                   : most_recent_reusable;
+}
+
+}  // namespace browser_cli
diff --git a/chrome/browser/browser_cli/reopen_window_selection.h b/chrome/browser/browser_cli/reopen_window_selection.h
new file mode 100644
index 0000000000..11eeb56590
--- /dev/null
+++ b/chrome/browser/browser_cli/reopen_window_selection.h
@@ -0,0 +1,50 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BROWSER_CLI_REOPEN_WINDOW_SELECTION_H_
+#define CHROME_BROWSER_BROWSER_CLI_REOPEN_WINDOW_SELECTION_H_
+
+#include <stddef.h>
+
+#include "base/containers/span.h"
+
+namespace browser_cli {
+
+// One existing browser window that an explicit user reopen (Dock / Launchpad /
+// app reopen) could present while Browser CLI managed background presentation
+// keeps every window hidden.
+//
+// Candidates are supplied in creation order (least recently created first),
+// which is stable and independent of activation history. The macOS app
+// controller fills these fields from BrowserWindowInterface and
+// NativeWidgetMacNSWindowHost.
+struct ReopenWindowCandidate {
+  // The window is a browser window the user can be given on reopen. App
+  // windows (TYPE_APP) are excluded from macOS window focusing as well, and
+  // DevTools windows are not a browser the user asked for.
+  bool is_reusable_browser_window = false;
+  // The window already carries per-window USER_EXPLICIT/HUMAN ownership from an
+  // earlier explicit user action, so it stays the user's window.
+  bool is_user_owned = false;
+};
+
+// Returned when no candidate may be presented and the caller must create a new
+// window instead.
+inline constexpr size_t kNoReopenWindow = static_cast<size_t>(-1);
+
+// Chooses the window to present for an explicit user reopen:
+//   1. non-reusable candidates are ignored;
+//   2. the most recently created user-owned candidate wins: the window the user
+//      explicitly opened before stays theirs;
+//   3. otherwise the most recently created reusable candidate wins;
+//   4. with no selectable candidate, returns kNoReopenWindow so the caller
+//      creates a new window.
+//
+// Pure function by design, so the selection is deterministic and unit-testable.
+size_t SelectReopenWindowCandidate(
+    base::span<const ReopenWindowCandidate> candidates);
+
+}  // namespace browser_cli
+
+#endif  // CHROME_BROWSER_BROWSER_CLI_REOPEN_WINDOW_SELECTION_H_
diff --git a/chrome/browser/browser_cli/reopen_window_selection_unittest.cc b/chrome/browser/browser_cli/reopen_window_selection_unittest.cc
new file mode 100644
index 0000000000..0b12a3a7e0
--- /dev/null
+++ b/chrome/browser/browser_cli/reopen_window_selection_unittest.cc
@@ -0,0 +1,81 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/reopen_window_selection.h"
+
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace browser_cli {
+namespace {
+
+ReopenWindowCandidate ReusableCandidate(bool user_owned = false) {
+  ReopenWindowCandidate candidate;
+  candidate.is_reusable_browser_window = true;
+  candidate.is_user_owned = user_owned;
+  return candidate;
+}
+
+ReopenWindowCandidate NonReusableCandidate(bool user_owned = false) {
+  ReopenWindowCandidate candidate;
+  candidate.is_reusable_browser_window = false;
+  candidate.is_user_owned = user_owned;
+  return candidate;
+}
+
+TEST(ReopenWindowSelectionTest, NoCandidatesMeansCreateNewWindow) {
+  const std::vector<ReopenWindowCandidate> candidates;
+  EXPECT_EQ(SelectReopenWindowCandidate(candidates), kNoReopenWindow);
+}
+
+TEST(ReopenWindowSelectionTest, OnlyNonReusableCandidatesMeansCreateNewWindow) {
+  const std::vector<ReopenWindowCandidate> candidates = {
+      NonReusableCandidate(), NonReusableCandidate(/*user_owned=*/true)};
+  EXPECT_EQ(SelectReopenWindowCandidate(candidates), kNoReopenWindow);
+}
+
+TEST(ReopenWindowSelectionTest, SingleReusableCandidateIsSelected) {
+  const std::vector<ReopenWindowCandidate> candidates = {ReusableCandidate()};
+  EXPECT_EQ(SelectReopenWindowCandidate(candidates), 0u);
+}
+
+TEST(ReopenWindowSelectionTest, MostRecentlyCreatedReusableCandidateWins) {
+  const std::vector<ReopenWindowCandidate> candidates = {
+      ReusableCandidate(), ReusableCandidate(), ReusableCandidate()};
+  EXPECT_EQ(SelectReopenWindowCandidate(candidates), 2u);
+}
+
+TEST(ReopenWindowSelectionTest, NonReusableCandidatesAreSkipped) {
+  const std::vector<ReopenWindowCandidate> trailing_non_reusable = {
+      ReusableCandidate(), NonReusableCandidate()};
+  EXPECT_EQ(SelectReopenWindowCandidate(trailing_non_reusable), 0u);
+
+  const std::vector<ReopenWindowCandidate> leading_non_reusable = {
+      NonReusableCandidate(), ReusableCandidate()};
+  EXPECT_EQ(SelectReopenWindowCandidate(leading_non_reusable), 1u);
+}
+
+TEST(ReopenWindowSelectionTest, UserOwnedCandidateWinsOverNewerCandidates) {
+  const std::vector<ReopenWindowCandidate> candidates = {
+      ReusableCandidate(/*user_owned=*/true), ReusableCandidate(),
+      ReusableCandidate()};
+  EXPECT_EQ(SelectReopenWindowCandidate(candidates), 0u);
+}
+
+TEST(ReopenWindowSelectionTest, MostRecentlyCreatedUserOwnedCandidateWins) {
+  const std::vector<ReopenWindowCandidate> candidates = {
+      ReusableCandidate(/*user_owned=*/true), ReusableCandidate(),
+      ReusableCandidate(/*user_owned=*/true), ReusableCandidate()};
+  EXPECT_EQ(SelectReopenWindowCandidate(candidates), 2u);
+}
+
+TEST(ReopenWindowSelectionTest, UserOwnedNonReusableCandidateIsIgnored) {
+  const std::vector<ReopenWindowCandidate> candidates = {
+      ReusableCandidate(), NonReusableCandidate(/*user_owned=*/true)};
+  EXPECT_EQ(SelectReopenWindowCandidate(candidates), 0u);
+}
+
+}  // namespace
+}  // namespace browser_cli
