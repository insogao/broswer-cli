diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index 8a60d7061b..5c5a5f934b 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -72,6 +72,12 @@ declare_args() {
   # signing identity. If `include_branded_entitlements` is set to false, these
   # entitlements will be skipped.
   include_branded_entitlements = true
+
+  # Browser CLI: directory (relative to //chrome) holding the macOS app icon
+  # assets `app.icns` and `Assets.car`. Empty selects the active Chromium
+  # branding directory. Set to a custom directory to use custom artwork; the
+  # assets are generated by scripts/generate-icons.sh from the approved source.
+  mac_app_icon_dir = ""
 }
 
 assert(!is_ios, "Chromium/iOS shouldn't use anything in //chrome")
@@ -484,6 +490,13 @@ if (is_win) {
   chrome_framework_name = chrome_product_full_name + " Framework"
   chrome_framework_version = chrome_version_full
 
+  # Browser CLI: macOS app icon assets (app.icns / Assets.car) may be overridden
+  # via the `mac_app_icon_dir` GN arg (see the declare_args block above).
+  _mac_app_icon_dir = "app/theme/$branding_path_component/mac"
+  if (mac_app_icon_dir != "") {
+    _mac_app_icon_dir = mac_app_icon_dir
+  }
+
   verify_dynamic_libraries = !is_component_build && !is_asan && !is_ubsan_any
   if (host_os == "mac") {
     objdump_path = mac_bin_path
@@ -662,12 +675,12 @@ if (is_win) {
   }
 
   bundle_data("chrome_app_icon") {
-    sources = [ "app/theme/$branding_path_component/mac/app.icns" ]
+    sources = [ "$_mac_app_icon_dir/app.icns" ]
     outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
   }
 
   bundle_data("chrome_asset_catalog") {
-    sources = [ "app/theme/$branding_path_component/mac/Assets.car" ]
+    sources = [ "$_mac_app_icon_dir/Assets.car" ]
     outputs = [ "{{bundle_resources_dir}}/{{source_file_part}}" ]
   }
 
