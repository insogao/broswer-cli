+          /*requester_is_agent_assist=*/
+          requester_origin == ForegroundOrigin::kAgentAssist, window_id,
+          IsUserExplicitOwned(window_id), active_window_id);
+
+  if (decision.result == ForegroundAssistRequestResult::kGranted) {
+    if (active_window_id != window_id) {
+      ForegroundLease lease;
+      lease.window_id = window_id;
+      lease.target_tab = target_tab;
+      lease.reason = reason;
+      lease.granted_at = Now();
+      lease.expires_at = lease.granted_at + kDefaultForegroundAssistLeaseTtl;
+      lease.request_seq = ++assist_request_seq_;
+      active_foreground_assist_lease_ = lease;
+    }
+    // The idempotent re-request for the lease holder reports the live lease
+    // (including its unchanged deadline) so the log always matches the state.
+    const ForegroundLease& live = *active_foreground_assist_lease_;
+    LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=policy"
+              << " transition=assist-lease-granted"
+              << " window_id=" << live.window_id
+              << " target_tab=" << live.target_tab
+              << " lease_reason=" << ForegroundAssistReasonToString(live.reason)
+              << " request_seq=" << live.request_seq
+              << " ttl_ms=" << kDefaultForegroundAssistLeaseTtl.InMilliseconds()
+              << " expires_at_ms="
+              << live.expires_at.since_origin().InMilliseconds()
+              << " reason=" << decision.reason;
+    return ForegroundAssistRequestResult::kGranted;
+  }
+
+  LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=policy"
+            << " transition=assist-lease-denied"
+            << " window_id=" << window_id << " target_tab=" << target_tab
+            << " lease_reason=" << ForegroundAssistReasonToString(reason)
+            << " active_window_id=" << active_window_id
+            << " reason=" << decision.reason;
+  return decision.result;
+}
