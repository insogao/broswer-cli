+// static
+NativeWidgetMacNSWindowHost* NativeWidgetMacNSWindowHost::GetFromWidgetId(
+    uint64_t widget_id) {
+  auto& hosts = GetIdToWidgetHostImplMap();
+  auto found = hosts.find(widget_id);
+  return found == hosts.end() ? nullptr : found->second;
+}
+
+bool NativeWidgetMacNSWindowHost::IsEligibleForegroundAssistTarget() {
+  const Widget* widget = GetWidget();
+  return widget && widget->is_top_level();
+}
+
+ForegroundAssistRequestResult
+NativeWidgetMacNSWindowHost::RequestForegroundAssistLease(
+    uint64_t target_tab,
+    ForegroundAssistReason reason) {
+  // Defense in depth: a non-top-level widget can never hold an assist lease,
+  // even if a caller bypasses the producer's own eligibility check.
+  if (!IsEligibleForegroundAssistTarget()) {
+    return ForegroundAssistRequestResult::kInvalidTarget;
+  }
+  return BrowserCliPresentationPolicy::Get()->RequestForegroundAssist(
+      ForegroundOrigin::kAgentAssist, widget_id_, target_tab, reason);
+}
+
+bool NativeWidgetMacNSWindowHost::IsForegroundAssistLeased() {
+  return BrowserCliPresentationPolicy::Get()->IsForegroundAssistLeased(
+      widget_id_);
+}
+
+void NativeWidgetMacNSWindowHost::ReleaseForegroundAssistLease(
+    ForegroundAssistReleaseReason reason) {
+  BrowserCliPresentationPolicy::Get()->ReleaseForegroundAssist(widget_id_,
+                                                               reason);
+}
+
+bool NativeWidgetMacNSWindowHost::PresentForAgentAssistAction() {
+  // Only reachable after the policy granted the lease for this window; the
+  // policy checks the lease again (kAgentAssist is an automation origin, so a
+  // HUMAN-owned window stays denied here).
+  const bool applied =
+      ApplyVisibilityState(WindowVisibilityState::kShowAndActivateWindow,
+                           ForegroundOrigin::kAgentAssist);
+  if (applied) {
+    LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=host"
+              << " transition=assist-window-visible"
+              << " widget_id=" << widget_id_
+              << " reason=agent-assist-lease-granted";
+  }
+  return applied;
+}
+
+void NativeWidgetMacNSWindowHost::HideForForegroundAssistRelease() {
+  // Defense in depth: the timeout and release owners already check this, but
+  // the gateway itself must never hide a window the user owns (invariant 5.3).
+  if (IsUserExplicitOwned()) {
+    return;
+  }
+  // Re-arm the per-window AppKit hard stop before hiding, so a later stray
+  // order-in cannot present the window without a new policy grant.
+  if (in_process_ns_window_) {
+    in_process_ns_window_.managedPresentationSuppressed = YES;
+  }
+  ApplyVisibilityState(WindowVisibilityState::kHideWindow,
+                       ForegroundOrigin::kAgentAssist);
+  LOG(INFO) << "BROWSER_CLI_PRESENTATION stage=host"
+            << " transition=assist-window-background"
+            << " widget_id=" << widget_id_ << " reason=assist-lease-released";
+}
