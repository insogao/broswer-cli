+// The only actions a live foreground assist lease grants to its own window for
+// the agent origin: the presentation the lease exists for, plus the proven
+// non-presenting bounds change. Everything else (minimize, maximize, restore,
+// fullscreen, deactivate, z-order) is denied even on the leased window.
+bool IsForegroundAssistAllowedAction(BrowserCliPresentationAction action) {
+  switch (action) {
+    case BrowserCliPresentationAction::kShowAndActivate:
+    case BrowserCliPresentationAction::kShowInactive:
+    case BrowserCliPresentationAction::kSetBounds:
+      return true;
+    case BrowserCliPresentationAction::kMinimize:
+    case BrowserCliPresentationAction::kMaximize:
+    case BrowserCliPresentationAction::kRestore:
+    case BrowserCliPresentationAction::kDeactivate:
+    case BrowserCliPresentationAction::kFullscreen:
+    case BrowserCliPresentationAction::kSetZOrder:
+      return false;
+  }
+}
