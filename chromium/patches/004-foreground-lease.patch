+TEST_F(BrowserCliPresentationPolicyTest,
+       AssistUnmanagedModeDeniesWithoutSideEffects) {
+  policy()->SetManagedModeEnabledForTesting(false);
+  policy()->SetNowForTesting(TestNow());
+
+  EXPECT_EQ(RequestAssist(130), ForegroundAssistRequestResult::kDenied);
+  EXPECT_EQ(policy()->active_foreground_assist_lease_count_for_testing(), 0u);
+  EXPECT_FALSE(policy()->IsForegroundAssistLeased(130));
+  EXPECT_EQ(policy()->ReleaseExpiredForegroundAssistLeases(), 0u);
+  policy()->ReleaseForegroundAssist(
+      130, ForegroundAssistReleaseReason::kAgentRelease);
+
+  // Stock Chromium behavior is untouched: every request is allowed.
+  EXPECT_TRUE(Allow(ForegroundOrigin::kAgentAssist,
+                    BrowserCliPresentationAction::kShowAndActivate, 130));
+}
