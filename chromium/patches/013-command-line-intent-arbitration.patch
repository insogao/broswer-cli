diff --git a/chrome/browser/browser_cli/foreground_assist.h b/chrome/browser/browser_cli/foreground_assist.h
index 787460ae79..dfeb578403 100644
--- a/chrome/browser/browser_cli/foreground_assist.h
+++ b/chrome/browser/browser_cli/foreground_assist.h
@@ -82,6 +82,31 @@ bool ForegroundAssistRequestClassConsumesCommandLine(
 // with only the auxiliary assist switches is kNotRequested and has no intent.
 bool HasForegroundAssistIntent(const base::CommandLine& command_line);
 
+// Which Browser CLI command-line producer owns |command_line|. Both production
+// entry points (the cold start and the forwarded ProcessSingleton
+// notification) must route through this single arbitration, so one command
+// line can never be consumed by the wrong producer:
+//   * kForegroundAssist: the command line carries an assist request or release
+//     intent. The assist producer handles it even when the command line also
+//     carries the user-explicit show switch; that conflicting combination is
+//     classified kBlockedByConflictingSwitches, denied and logged, and
+//     consumed so it can never reach the USER_EXPLICIT show producer or its
+//     presentation gateway.
+//   * kUserExplicitShow: no assist intent, but the explicit show switch is
+//     present. The show producer handles it (and still falls back to ordinary
+//     processing when the command line carries launch arguments).
+//   * kOrdinary: neither intent; stock command-line processing.
+enum class BrowserCliCommandLineIntent {
+  kOrdinary,
+  kForegroundAssist,
+  kUserExplicitShow,
+};
+
+// Pure and deterministic. An assist intent always wins over the show switch;
+// this function is the only place that decides the handler order.
+BrowserCliCommandLineIntent ArbitrateBrowserCliCommandLineIntent(
+    const base::CommandLine& command_line);
+
 // The command line the cold-start startup (`StartupBrowserCreator::Start`) must
 // use:
 //   * without an assist intent: an unchanged copy of |command_line|;
