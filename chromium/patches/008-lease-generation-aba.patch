+  ASSERT_EQ(RequestAssist(45), ForegroundAssistRequestResult::kGranted);
+  const uint64_t first = policy()->GetForegroundAssistLeaseGeneration(45);
+  EXPECT_GT(first, 0u);
+  EXPECT_EQ(policy()->GetForegroundAssistLeaseGeneration(46), 0u);
+
+  // An idempotent re-request keeps the same lease and generation.
+  ASSERT_EQ(RequestAssist(45), ForegroundAssistRequestResult::kGranted);
+  EXPECT_EQ(policy()->GetForegroundAssistLeaseGeneration(45), first);
+
+  // A lease that expired lazily reports no generation.
