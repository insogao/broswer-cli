+void BrowserCliPresentationPolicy::ReleaseForegroundAssist(
+    uint64_t window_id,
+    ForegroundAssistReleaseReason reason) {
+  EnsureInitializedFromCommandLine();
+  if (!managed_mode_enabled_) {
+    return;
+  }
+  ReleaseExpiredForegroundAssistLeasesLocked();
+  ReleaseForegroundAssistLocked(window_id, reason);
+}
+
+size_t BrowserCliPresentationPolicy::ReleaseExpiredForegroundAssistLeases() {
+  EnsureInitializedFromCommandLine();
+  if (!managed_mode_enabled_) {
+    return 0;
+  }
+  return ReleaseExpiredForegroundAssistLeasesLocked();
