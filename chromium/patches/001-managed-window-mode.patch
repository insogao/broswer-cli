+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/views/widget/browser_cli_presentation_policy.h"
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace views {
+namespace {
+
+constexpr BrowserCliPresentationAction kAllActions[] = {
+    BrowserCliPresentationAction::kShowAndActivate,
+    BrowserCliPresentationAction::kShowInactive,
+    BrowserCliPresentationAction::kMinimize,
+    BrowserCliPresentationAction::kMaximize,
+    BrowserCliPresentationAction::kRestore,
+    BrowserCliPresentationAction::kDeactivate,
+    BrowserCliPresentationAction::kFullscreen,
+    BrowserCliPresentationAction::kSetBounds,
+    BrowserCliPresentationAction::kSetZOrder};
+
+constexpr ForegroundOrigin kAutomationOrigins[] = {
+    ForegroundOrigin::kAgentAssist, ForegroundOrigin::kExtension,
+    ForegroundOrigin::kWebPage, ForegroundOrigin::kSessionRestore};
+
+// Browser CLI tests for the per-window USER_EXPLICIT/HUMAN ownership model.
+// The policy is a pure in-process state machine here: no native window is
+// created and no command line switch is needed (managed mode is forced via
+// SetManagedModeEnabledForTesting).
+class BrowserCliPresentationPolicyTest : public testing::Test {
+ protected:
+  void SetUp() override { policy()->ResetForTesting(); }
+  void TearDown() override { policy()->ResetForTesting(); }
+
+  BrowserCliPresentationPolicy* policy() {
+    return BrowserCliPresentationPolicy::Get();
+  }
+
+  bool Allow(ForegroundOrigin origin,
+             BrowserCliPresentationAction action,
+             uint64_t window_id) {
+    return policy()->AllowPresentation(origin, action, window_id);
+  }
+
+  bool AllowInternal(uint64_t window_id,
+                     BrowserCliPresentationAction action =
+                         BrowserCliPresentationAction::kShowAndActivate) {
+    return Allow(ForegroundOrigin::kInternal, action, window_id);
+  }
+};
+
+TEST_F(BrowserCliPresentationPolicyTest, UnmanagedAllowsAndTracksNothing) {
+  EXPECT_FALSE(policy()->IsManagedModeEnabled());
+  EXPECT_EQ(policy()->state_for_testing(),
+            BrowserCliPresentationState::kUnmanaged);
+
+  EXPECT_TRUE(AllowInternal(1));
+  EXPECT_TRUE(Allow(ForegroundOrigin::kUserExplicit,
+                    BrowserCliPresentationAction::kShowAndActivate, 1));
+  EXPECT_FALSE(policy()->IsUserExplicitOwned(1));
+  EXPECT_EQ(policy()->user_explicit_owned_window_count_for_testing(), 0u);
+}
+
+TEST_F(BrowserCliPresentationPolicyTest,
+       BackgroundDeniesEveryActionExceptBoundsForUnowned) {
+  policy()->SetManagedModeEnabledForTesting(true);
+  EXPECT_EQ(policy()->state_for_testing(),
+            BrowserCliPresentationState::kBackground);
+
+  const ForegroundOrigin non_user_origins[] = {
+      ForegroundOrigin::kInternal, ForegroundOrigin::kAgentAssist,
+      ForegroundOrigin::kExtension, ForegroundOrigin::kWebPage,
+      ForegroundOrigin::kSessionRestore};
+
+  for (ForegroundOrigin origin : non_user_origins) {
+    for (BrowserCliPresentationAction action : kAllActions) {
+      const bool expected_allow =
+          action == BrowserCliPresentationAction::kSetBounds;
+      EXPECT_EQ(Allow(origin, action, /*window_id=*/7), expected_allow)
+          << "origin=" << static_cast<int>(origin)
+          << " action=" << static_cast<int>(action);
+    }
+  }
+  EXPECT_FALSE(policy()->IsUserExplicitOwned(7));
+}
+
+// Regression test for the reviewed security gap: state changes that can
+// implicitly show, re-order or restore a hidden window must stay denied for
+// every origin on an unowned background window.
+TEST_F(BrowserCliPresentationPolicyTest,
+       BackgroundDeniesStateChangesThatCouldImplicitlyPresent) {
+  policy()->SetManagedModeEnabledForTesting(true);
+  constexpr BrowserCliPresentationAction kImplicitPresentationActions[] = {
+      BrowserCliPresentationAction::kShowAndActivate,
+      BrowserCliPresentationAction::kShowInactive,
+      BrowserCliPresentationAction::kMinimize,
+      BrowserCliPresentationAction::kMaximize,
+      BrowserCliPresentationAction::kRestore,
+      BrowserCliPresentationAction::kDeactivate,
+      BrowserCliPresentationAction::kFullscreen,
+      BrowserCliPresentationAction::kSetZOrder};
+
+  for (ForegroundOrigin origin : kAutomationOrigins) {
+    for (BrowserCliPresentationAction action : kImplicitPresentationActions) {
+      EXPECT_FALSE(Allow(origin, action, /*window_id=*/9))
+          << "origin=" << static_cast<int>(origin)
+          << " action=" << static_cast<int>(action);
+    }
+  }
+  for (BrowserCliPresentationAction action : kImplicitPresentationActions) {
+    EXPECT_FALSE(Allow(ForegroundOrigin::kInternal, action, /*window_id=*/9))
+        << "action=" << static_cast<int>(action);
+  }
+
+  // The only proven non-presenting background action stays available to
+  // Chrome's own window arrangement and to background automation.
+  EXPECT_TRUE(AllowInternal(9, BrowserCliPresentationAction::kSetBounds));
+  EXPECT_TRUE(Allow(ForegroundOrigin::kExtension,
+                    BrowserCliPresentationAction::kSetBounds, 9));
+}
+
+// Core regression test for the former process-wide `kHuman` allow: one user
+// window must not authorize another window.
+TEST_F(BrowserCliPresentationPolicyTest,
+       UserExplicitOwnsOnlyThePresentedWindow) {
+  policy()->SetManagedModeEnabledForTesting(true);
+
+  EXPECT_TRUE(Allow(ForegroundOrigin::kUserExplicit,
+                    BrowserCliPresentationAction::kShowAndActivate,
+                    /*window_id=*/1));
+  EXPECT_TRUE(policy()->IsUserExplicitOwned(1));
+  EXPECT_EQ(policy()->user_explicit_owned_window_count_for_testing(), 1u);
+
+  // The user's window keeps responding to un-attributed Chrome-internal
+  // requests (menu/button flows that cannot be attributed further), for every
+  // action.
+  for (BrowserCliPresentationAction action : kAllActions) {
+    EXPECT_TRUE(Allow(ForegroundOrigin::kInternal, action, /*window_id=*/1))
+        << "action=" << static_cast<int>(action);
+  }
+  EXPECT_EQ(policy()->state_for_testing(),
+            BrowserCliPresentationState::kBackground);
+
+  // Invariant 5.3: no automation origin may show, minimize, re-show, restore,
+  // maximize, fullscreen, deactivate, move or resize the user's window.
+  for (ForegroundOrigin origin : kAutomationOrigins) {
+    for (BrowserCliPresentationAction action : kAllActions) {
+      EXPECT_FALSE(Allow(origin, action, /*window_id=*/1))
+          << "origin=" << static_cast<int>(origin)
+          << " action=" << static_cast<int>(action);
+    }
+  }
+  EXPECT_TRUE(policy()->IsUserExplicitOwned(1));
+
+  // Every other window stays suppressed for every action and origin, except
+  // the proven non-presenting bounds change.
+  for (BrowserCliPresentationAction action : kAllActions) {
+    const bool expected_allow =
+        action == BrowserCliPresentationAction::kSetBounds;
+    EXPECT_EQ(Allow(ForegroundOrigin::kInternal, action, /*window_id=*/2),
+              expected_allow)
+        << "action=" << static_cast<int>(action);
+  }
+  EXPECT_FALSE(policy()->IsUserExplicitOwned(2));
+
+  // A second explicit user action owns its own window without affecting the
+  // first one.
+  EXPECT_TRUE(Allow(ForegroundOrigin::kUserExplicit,
+                    BrowserCliPresentationAction::kShowAndActivate,
+                    /*window_id=*/2));
+  EXPECT_EQ(policy()->user_explicit_owned_window_count_for_testing(), 2u);
+  EXPECT_TRUE(AllowInternal(1));
+  EXPECT_TRUE(AllowInternal(2));
+}
+
+TEST_F(BrowserCliPresentationPolicyTest, ReleaseRestoresBackgroundDenial) {
+  policy()->SetManagedModeEnabledForTesting(true);
+
+  EXPECT_TRUE(Allow(ForegroundOrigin::kUserExplicit,
+                    BrowserCliPresentationAction::kShowAndActivate,
+                    /*window_id=*/3));
+  EXPECT_TRUE(AllowInternal(3));
+
+  policy()->ReleaseUserExplicitOwnership(3, "unit-test-hand-back");
+  EXPECT_FALSE(policy()->IsUserExplicitOwned(3));
+  EXPECT_EQ(policy()->user_explicit_owned_window_count_for_testing(), 0u);
+  EXPECT_FALSE(AllowInternal(3));
+
+  // A later explicit user action can re-own the window.
+  EXPECT_TRUE(Allow(ForegroundOrigin::kUserExplicit,
+                    BrowserCliPresentationAction::kShowAndActivate,
+                    /*window_id=*/3));
+  EXPECT_TRUE(AllowInternal(3));
+}
+
+TEST_F(BrowserCliPresentationPolicyTest,
+       ReleasedOwnershipDoesNotLeakToOtherIds) {
+  policy()->SetManagedModeEnabledForTesting(true);
+
+  EXPECT_TRUE(Allow(ForegroundOrigin::kUserExplicit,
+                    BrowserCliPresentationAction::kShowAndActivate,
+                    /*window_id=*/4));
+  policy()->ReleaseUserExplicitOwnership(4, "window-destroyed");
+  EXPECT_FALSE(AllowInternal(4));
+  EXPECT_FALSE(policy()->IsUserExplicitOwned(4));
+}
+
+TEST_F(BrowserCliPresentationPolicyTest, UnknownWindowIdIsAllowedButNotOwned) {
+  policy()->SetManagedModeEnabledForTesting(true);
+
+  // window_id 0 means "unknown": the user-explicit request itself may proceed
+  // (invariant 5.2), but it cannot establish ownership.
+  EXPECT_TRUE(Allow(ForegroundOrigin::kUserExplicit,
+                    BrowserCliPresentationAction::kShowAndActivate,
+                    /*window_id=*/0));
+  EXPECT_FALSE(policy()->IsUserExplicitOwned(0));
+  EXPECT_EQ(policy()->user_explicit_owned_window_count_for_testing(), 0u);
+  EXPECT_FALSE(AllowInternal(0));
+}
+
+TEST_F(BrowserCliPresentationPolicyTest, DisabledModeIgnoresOwnershipApi) {
+  policy()->SetManagedModeEnabledForTesting(false);
+
+  policy()->ReleaseUserExplicitOwnership(5, "unit-test");
+  EXPECT_FALSE(policy()->IsUserExplicitOwned(5));
+  EXPECT_EQ(policy()->state_for_testing(),
+            BrowserCliPresentationState::kUnmanaged);
+
+  EXPECT_TRUE(Allow(ForegroundOrigin::kUserExplicit,
+                    BrowserCliPresentationAction::kShowAndActivate,
+                    /*window_id=*/5));
+  EXPECT_FALSE(policy()->IsUserExplicitOwned(5));
+  EXPECT_TRUE(AllowInternal(5));
+}
+
+TEST_F(BrowserCliPresentationPolicyTest,
+       HumanOwnedWindowDeniesAutomationButKeepsOwnership) {
+  policy()->SetManagedModeEnabledForTesting(true);
+  ASSERT_TRUE(Allow(ForegroundOrigin::kUserExplicit,
+                    BrowserCliPresentationAction::kShowAndActivate,
+                    /*window_id=*/11));
+
+  for (ForegroundOrigin origin : kAutomationOrigins) {
+    for (BrowserCliPresentationAction action : kAllActions) {
+      EXPECT_FALSE(Allow(origin, action, /*window_id=*/11))
+          << "origin=" << static_cast<int>(origin)
+          << " action=" << static_cast<int>(action);
+    }
+  }
+
+  // Denied automation requests must not release the user's ownership, and
+  // un-attributed internal requests stay allowed for every action.
+  EXPECT_TRUE(policy()->IsUserExplicitOwned(11));
+  for (BrowserCliPresentationAction action : kAllActions) {
+    EXPECT_TRUE(Allow(ForegroundOrigin::kInternal, action, /*window_id=*/11))
+        << "action=" << static_cast<int>(action);
+  }
+}
+
+TEST_F(BrowserCliPresentationPolicyTest,
+       ForegroundOriginScopeDefaultsToInternal) {
+  EXPECT_EQ(CurrentForegroundOrigin(), ForegroundOrigin::kInternal);
+}
+
+TEST_F(BrowserCliPresentationPolicyTest, ForegroundOriginScopeSetsAndRestores) {
+  {
+    ScopedForegroundOrigin extension_scope(ForegroundOrigin::kExtension);
+    EXPECT_EQ(CurrentForegroundOrigin(), ForegroundOrigin::kExtension);
+    {
+      ScopedForegroundOrigin web_scope(ForegroundOrigin::kWebPage);
+      EXPECT_EQ(CurrentForegroundOrigin(), ForegroundOrigin::kWebPage);
+    }
+    EXPECT_EQ(CurrentForegroundOrigin(), ForegroundOrigin::kExtension);
+  }
+  EXPECT_EQ(CurrentForegroundOrigin(), ForegroundOrigin::kInternal);
+}
+
+// Regression test for the `chrome.tabs.create` asynchronous window-creation
+// path. TabsCreateFunction::Run() hands the continuation to
+// CreateBrowserWindow(), which posts it on the same thread, so the producer's
+// scope has already unwound when the continuation runs. The extension origin
+// must therefore be bound by value across the task hop and re-scoped inside the
+// continuation (TabsCreateFunction::OnBrowserWindowCreatedWithOrigin). This
+// pins that exact primitive: the re-established scope is visible inside the
+// bound callback and does not leak into later tasks.
+TEST_F(BrowserCliPresentationPolicyTest,
+       BoundContinuationReattachesOriginWithoutLeaking) {
+  ForegroundOrigin captured = ForegroundOrigin::kInternal;
+  {
+    ScopedForegroundOrigin run_scope(ForegroundOrigin::kExtension);
+    captured = CurrentForegroundOrigin();
+  }
+  // The task hop: no scope is active anymore when the continuation runs.
+  EXPECT_EQ(CurrentForegroundOrigin(), ForegroundOrigin::kInternal);
+
+  bool continuation_saw_extension = false;
+  base::OnceClosure continuation = base::BindOnce(
+      [](ForegroundOrigin origin, bool* saw_extension) {
+        ScopedForegroundOrigin continuation_scope(origin);
+        *saw_extension =
+            CurrentForegroundOrigin() == ForegroundOrigin::kExtension;
+      },
+      captured, &continuation_saw_extension);
+  std::move(continuation).Run();
+
+  EXPECT_TRUE(continuation_saw_extension);
+  // The continuation's scope must not outlive the callback.
+  EXPECT_EQ(CurrentForegroundOrigin(), ForegroundOrigin::kInternal);
+}
