+++ b/chrome/browser/browser_cli/user_explicit_presentation.h
@@ -0,0 +1,48 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BROWSER_CLI_USER_EXPLICIT_PRESENTATION_H_
+#define CHROME_BROWSER_BROWSER_CLI_USER_EXPLICIT_PRESENTATION_H_
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+
+class BrowserWindowInterface;
+
+namespace browser_cli {
+
+// Browser CLI shared explicit-user presentation helpers (macOS). This is the
+// single presentation path for Dock / Launchpad / app reopen and the CLI
+// explicit `show` producer; it never broadens automation origins and grants
+// per-window USER_EXPLICIT/HUMAN ownership only to the presented window.
+
+// Presents |browser|'s native window because the user explicitly asked for it.
+// Returns whether the presentation was applied; a no-op in stock (unmanaged)
+// Chromium.
+bool PresentBrowserForUserExplicitAction(BrowserWindowInterface* browser);
+
+// Presents one existing reusable browser window for an explicit user action,
+// preferring a window the user already owns. Returns true when an existing
+// window was presented; false means the caller should fall back to creating a
+// new window (no reusable window exists, or managed mode is disabled).
+bool PresentExistingWindowForUserExplicitAction();
+
+// Browser CLI explicit `show` producer. Handles a command line that may
+// carry `--browser-cli-user-explicit-show`, from either the cold-start path
+// (after the startup browser was created) or a forwarded ProcessSingleton
+// notification sent by a second direct binary invocation.
+//
+// Returns true when the request was consumed: an existing window was
+// presented, exactly one window was created and presented, or the request was
+// denied / failed (fail closed, with a structured log). Returns false when the
+// caller must continue ordinary command-line processing: the switch is absent,
+// the process is unmanaged, or the command line also carries launch arguments
+// (URL / `--app` / `--app-id` / `--incognito` / `--enable-automation` /
+// `--headless`) that must never be granted USER_EXPLICIT.
+bool HandleUserExplicitShowRequest(const base::CommandLine& command_line,
+                                   const base::FilePath& current_directory);
+
+}  // namespace browser_cli
+
+#endif  // CHROME_BROWSER_BROWSER_CLI_USER_EXPLICIT_PRESENTATION_H_
diff --git a/chrome/browser/browser_cli/user_explicit_presentation.mm b/chrome/browser/browser_cli/user_explicit_presentation.mm
new file mode 100644
index 0000000000..8d62708d37
--- /dev/null
+++ b/chrome/browser/browser_cli/user_explicit_presentation.mm
@@ -0,0 +1,226 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/user_explicit_presentation.h"
+
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/logging.h"
+#include "base/notreached.h"
+#include "chrome/browser/browser_cli/reopen_window_selection.h"
+#include "chrome/browser/browser_cli/user_explicit_show.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_collection.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/startup/startup_browser_creator.h"
+#include "ui/base/base_window.h"
+#include "ui/views/cocoa/native_widget_mac_ns_window_host.h"
+
+namespace browser_cli {
+namespace {
+
+// Structured producer log. `result` is handled / denied / failed / noop and
+// `reason` is the stable machine-readable outcome reason; the presentation
+// policy adds its own BROWSER_CLI_PRESENTATION decision log for every actual
+// request, so an allow/deny pair can always be correlated.
+void LogProducerOutcome(const char* result,
+                        const char* reason,
+                        bool managed_mode) {
+  LOG(INFO) << "BROWSER_CLI_USER_EXPLICIT_SHOW stage=producer"
+            << " result=" << result << " reason=" << reason
+            << " managed=" << (managed_mode ? "yes" : "no");
+}
+
+// Presents |browser|'s native window because the user explicitly asked for it.
+// Managed-mode detection and the presentation are both routed through
+// NativeWidgetMacNSWindowHost (inside the ui/views component), so this file
+// never reaches the presentation policy singleton directly and the process
+// keeps exactly one policy state. The presentation is attributed USER_EXPLICIT
+// and grants per-window HUMAN ownership to that one window; no other managed
+// window is unsuppressed, so an agent/extension/web page/session restore can
+// never ride along on the user's action. Returns whether the presentation was
+// applied. In stock (unmanaged) Chromium this is a no-op because the window
+// already showed itself and the check below is false.
+bool PresentBrowserWindowUserExplicitly(BrowserWindowInterface* browser) {
+  if (!views::NativeWidgetMacNSWindowHost::
+          IsBrowserCliManagedPresentationEnabled()) {
+    return false;
+  }
+  if (!browser || !browser->GetWindow()) {
+    return false;
+  }
+  views::NativeWidgetMacNSWindowHost* host =
+      views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+          browser->GetWindow()->GetNativeWindow());
+  if (!host) {
+    return false;
+  }
+  return host->PresentForUserExplicitAction();
+}
+
+// Returns the window a user-explicit presentation should pick, or nullptr when
+// no reusable window exists. Candidates are collected in creation order (least
+// recently created first), which is stable and independent of activation
+// history; managed mode suppresses activation, so activation order would be
+// unreliable. Nothing is presented here, which keeps this a pure lookup.
+BrowserWindowInterface* FindReusableWindowForUserExplicitAction() {
+  if (!g_browser_process) {
+    return nullptr;
+  }
+
+  // Windows without a native host cannot be presented and are skipped.
+  std::vector<BrowserWindowInterface*> browsers;
+  std::vector<ReopenWindowCandidate> candidates;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&browsers, &candidates](BrowserWindowInterface* browser) {
+        if (!browser->GetWindow()) {
+          return true;
+        }
+        views::NativeWidgetMacNSWindowHost* host =
+            views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+                browser->GetWindow()->GetNativeWindow());
+        if (!host) {
+          return true;
+        }
+        ReopenWindowCandidate candidate;
+        const BrowserWindowInterface::Type type = browser->GetType();
+        candidate.is_reusable_browser_window =
+            type != BrowserWindowInterface::TYPE_APP &&
+            type != BrowserWindowInterface::TYPE_DEVTOOLS;
+        candidate.is_user_owned = host->IsUserExplicitOwned();
+        browsers.push_back(browser);
+        candidates.push_back(candidate);
+        return true;
+      },
+      BrowserCollection::Order::kCreation);
+
+  const size_t selected = SelectReopenWindowCandidate(candidates);
+  if (selected == kNoReopenWindow) {
+    return nullptr;
+  }
+  return browsers[selected];
+}
+
+// Resolves the profile an explicit show may create a window in. Only an
+// already-loaded profile can be used synchronously: the profile picker is
+// never shown and a profile is never loaded asynchronously for a show request,
+// so this fails closed with nullptr instead.
+Profile* ResolveLoadedProfileForUserExplicitShow(
+    const base::CommandLine& command_line,
+    const base::FilePath& current_directory) {
+  ProfileManager* profile_manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  if (!profile_manager) {
+    return nullptr;
+  }
+  const StartupProfilePathInfo path_info = GetStartupProfilePath(
+      current_directory, command_line, /*ignore_profile_picker=*/true);
+  if (path_info.mode != StartupProfileMode::kBrowserWindow) {
+    return nullptr;
+  }
+  return profile_manager->GetProfileByPath(path_info.path);
+}
+
+// Creates exactly one empty window for `profile` and presents it. Session
+// restore is explicitly disabled and the scripted creation returns the created
+// window (or nullptr on failure), so a failed creation can never present an
+// unrelated window that happens to be the most recent one.
+bool CreateAndPresentWindowForUserExplicitAction(Profile* profile) {
+  if (!profile) {
+    return false;
+  }
+  BrowserWindowInterface* created = chrome::OpenEmptyWindow(
+      profile, /*should_trigger_session_restore=*/false);
+  return PresentBrowserWindowUserExplicitly(created);
+}
+
+}  // namespace
+
+bool PresentBrowserForUserExplicitAction(BrowserWindowInterface* browser) {
+  return PresentBrowserWindowUserExplicitly(browser);
+}
+
+bool PresentExistingWindowForUserExplicitAction() {
+  if (!views::NativeWidgetMacNSWindowHost::
+          IsBrowserCliManagedPresentationEnabled()) {
+    return false;
+  }
+  return PresentBrowserWindowUserExplicitly(
+      FindReusableWindowForUserExplicitAction());
+}
+
+bool HandleUserExplicitShowRequest(const base::CommandLine& command_line,
+                                   const base::FilePath& current_directory) {
+  const UserExplicitShowRequestClass request_class =
+      ClassifyUserExplicitShowRequest(command_line);
+  if (request_class == UserExplicitShowRequestClass::kNotRequested) {
+    return false;
+  }
+
+  const bool managed_mode = views::NativeWidgetMacNSWindowHost::
+      IsBrowserCliManagedPresentationEnabled();
+
+  // Only a pure show request in managed mode looks for an existing window;
+  // every other case must not touch the collection.
+  BrowserWindowInterface* reusable =
+      request_class == UserExplicitShowRequestClass::kShow && managed_mode
+          ? FindReusableWindowForUserExplicitAction()
+          : nullptr;
+
+  switch (
+      PlanUserExplicitShow(request_class, managed_mode, reusable != nullptr)) {
+    case UserExplicitShowPlan::kNoAction:
+      if (request_class ==
+          UserExplicitShowRequestClass::kBlockedByLaunchArguments) {
+        // Never ride a URL / app / incognito launch into a USER_EXPLICIT
+        // presentation. The caller continues ordinary command-line processing,
+        // which creates only background-managed windows.
+        LogProducerOutcome("denied", "launch-arguments-not-user-explicit",
+                           managed_mode);
+      } else {
+        // Stock Chromium already presents its own windows; the producer must
+        // not add a duplicate visibility path or a duplicate window.
+        LogProducerOutcome("noop", "unmanaged-stock-behavior", managed_mode);
+      }
+      return false;
+
+    case UserExplicitShowPlan::kPresentExistingWindow:
+      if (PresentBrowserWindowUserExplicitly(reusable)) {
+        LogProducerOutcome("handled", "existing-window-presented",
+                           managed_mode);
+      } else {
+        // Do not fall through to create: an existing window exists, so
+        // creating another one would violate "exactly one reusable window".
+        LogProducerOutcome("failed", "existing-window-presentation-denied",
+                           managed_mode);
+      }
+      return true;
+
+    case UserExplicitShowPlan::kCreateWindowThenPresent: {
+      Profile* profile = ResolveLoadedProfileForUserExplicitShow(
+          command_line, current_directory);
+      if (!profile) {
+        LogProducerOutcome("failed", "profile-not-loaded", managed_mode);
+        return true;
+      }
+      if (CreateAndPresentWindowForUserExplicitAction(profile)) {
+        LogProducerOutcome("handled", "window-created-and-presented",
+                           managed_mode);
+      } else {
+        LogProducerOutcome("failed", "window-creation-or-presentation-denied",
+                           managed_mode);
+      }
+      return true;
+    }
+  }
+
+  NOTREACHED();
+}
+
+}  // namespace browser_cli
diff --git a/chrome/browser/browser_cli/user_explicit_show.cc b/chrome/browser/browser_cli/user_explicit_show.cc
new file mode 100644
index 0000000000..3a094408b8
--- /dev/null
+++ b/chrome/browser/browser_cli/user_explicit_show.cc
@@ -0,0 +1,51 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/browser_cli/user_explicit_show.h"
+
+#include "chrome/common/chrome_switches.h"
+#include "content/public/common/content_switches.h"
+#include "ui/gfx/switches.h"
+
+namespace browser_cli {
+
+UserExplicitShowRequestClass ClassifyUserExplicitShowRequest(
+    const base::CommandLine& command_line) {
+  if (!command_line.HasSwitch(kBrowserCliUserExplicitShowSwitch)) {
+    return UserExplicitShowRequestClass::kNotRequested;
+  }
+  // Positional arguments are URLs. `--app` and `--app-id` launch app windows,
+  // `--incognito` launches an off-the-record window, and `--enable-automation`
+  // or `--headless` mark automated / headless launches. None of them is a
+  // pure "show what is already there" request, so they must not be granted
+  // USER_EXPLICIT presentation; an automated or headless launch must never
+  // present a window.
+  if (!command_line.GetArgs().empty() ||
+      command_line.HasSwitch(switches::kApp) ||
+      command_line.HasSwitch(switches::kAppId) ||
+      command_line.HasSwitch(switches::kIncognito) ||
+      command_line.HasSwitch(switches::kEnableAutomation) ||
+      command_line.HasSwitch(switches::kHeadless)) {
+    return UserExplicitShowRequestClass::kBlockedByLaunchArguments;
+  }
+  return UserExplicitShowRequestClass::kShow;
+}
+
+UserExplicitShowPlan PlanUserExplicitShow(
+    UserExplicitShowRequestClass request_class,
+    bool managed_mode_enabled,
+    bool has_reusable_window) {
+  if (request_class != UserExplicitShowRequestClass::kShow) {
+    return UserExplicitShowPlan::kNoAction;
+  }
+  if (!managed_mode_enabled) {
+    // Stock Chromium already presents its own windows; the producer must not
+    // add a duplicate visibility path or a duplicate window.
+    return UserExplicitShowPlan::kNoAction;
+  }
+  return has_reusable_window ? UserExplicitShowPlan::kPresentExistingWindow
+                             : UserExplicitShowPlan::kCreateWindowThenPresent;
+}
+
+}  // namespace browser_cli
diff --git a/chrome/browser/browser_cli/user_explicit_show.h b/chrome/browser/browser_cli/user_explicit_show.h
new file mode 100644
index 0000000000..81decdd1e8
--- /dev/null
+++ b/chrome/browser/browser_cli/user_explicit_show.h
@@ -0,0 +1,73 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_BROWSER_CLI_USER_EXPLICIT_SHOW_H_
+#define CHROME_BROWSER_BROWSER_CLI_USER_EXPLICIT_SHOW_H_
+
+#include "base/command_line.h"
+
+namespace browser_cli {
+
+// Command-line switch of the Browser CLI explicit `show` producer. The switch
+// is only set by a separately launched Browser CLI binary invocation: either
+// the cold-start argv of this process or the argv forwarded by a second
+// invocation through ProcessSingleton. Renderers, extensions, web pages and
+// browser-internal code never produce it, so a command line carrying it can be
+// attributed to the user and granted USER_EXPLICIT presentation.
+inline constexpr char kBrowserCliUserExplicitShowSwitch[] =
+    "browser-cli-user-explicit-show";
+
+// Classification of one command line for the explicit `show` producer. Pure,
+// so the cold-start path and the forwarded-notification path share exactly one
+// decision and unit tests need no browser process.
+enum class UserExplicitShowRequestClass {
+  // The switch is absent: ordinary, stock command-line processing.
+  kNotRequested,
+  // The switch is present and the command line carries no launch arguments
+  // (no URL, `--app`, `--app-id`, `--incognito`, `--enable-automation` or
+  // `--headless`): a pure explicit show.
+  kShow,
+  // The switch is present but the command line also launches something (a URL,
+  // an app window, an incognito window) or marks an automated / headless
+  // launch. Such a request must never be granted USER_EXPLICIT; it falls back
+  // to ordinary command-line processing, which keeps the window in the
+  // background.
+  kBlockedByLaunchArguments,
+};
+
+// How the explicit `show` producer must act on a classified request. Pure and
+// deterministic for unit testing. `has_reusable_window` reports whether
+// SelectReopenWindowCandidate() found an existing window that can be presented.
+enum class UserExplicitShowPlan {
+  // Do not touch presentation: no show was requested, the process is
+  // unmanaged (stock Chromium already presents its own windows), or the
+  // request was blocked and must be handled as an ordinary command line.
+  kNoAction,
+  // Present the existing reusable window through the single per-window
+  // USER_EXPLICIT/HUMAN presentation path.
+  kPresentExistingWindow,
+  // Create exactly one empty window for the resolved already-loaded profile
+  // (no profile picker, no session restore) and present it.
+  kCreateWindowThenPresent,
+};
+
+// Returns kShow only for a pure explicit show request. Anything that also
+// launches a URL, an app window or an incognito window, or that marks an
+// automated (`--enable-automation`) / headless (`--headless`) launch, is
+// classified as kBlockedByLaunchArguments, so those command lines can never
+// ride along into an explicit presentation.
+UserExplicitShowRequestClass ClassifyUserExplicitShowRequest(
+    const base::CommandLine& command_line);
+
+// Maps a classified request and the producer's environment to the one action
+// to take. In unmanaged mode the plan is always kNoAction: it must not add a
+// duplicate visibility path or a duplicate window to stock Chromium.
+UserExplicitShowPlan PlanUserExplicitShow(
+    UserExplicitShowRequestClass request_class,
+    bool managed_mode_enabled,
+    bool has_reusable_window);
+
+}  // namespace browser_cli
+
+#endif  // CHROME_BROWSER_BROWSER_CLI_USER_EXPLICIT_SHOW_H_
