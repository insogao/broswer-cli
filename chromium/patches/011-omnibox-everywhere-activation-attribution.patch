+// How a browser-window activation requested by an Omnibox Everywhere producer
+// must be routed. Pure so the policy can be unit-tested without a window or a
+// browser process.
+enum class WindowActivationRoute {
+  // Managed Browser CLI without provable user input: fail closed. No app
+  // activation, no native restore and no order-front; the navigation request
+  // keeps whatever decision the presentation policy already made.
+  kNoop,
+  // Managed Browser CLI with a provable browser-process user input: present the
+  // target window through the single USER_EXPLICIT presentation gateway.
+  kExplicitGateway,
+  // Stock Chromium: keep the original native activation behavior below.
+  kDirectAppKit,
+};
+
+// Decides the route for one activation request. |managed_mode| is the Browser
+// CLI managed background-presentation mode; |user_gesture| may only be true for
+// a browser-process user input (an AppKit/Views menu command), never for a
+// renderer-reported or WebUI callback.
+WindowActivationRoute DecideWindowActivationRoute(bool managed_mode,
+                                                  bool user_gesture);
+
+// Activates the browser window and ensures macOS switches spaces to Chrome, or
+// routes through the presentation gateway in managed mode.
+// |user_gesture| is the provenance of the request: only proven browser-process
+// user input may be presented as USER_EXPLICIT.
+void ActivateBrowserWindowOnMac(BrowserWindowInterface* bwi, bool user_gesture);
 #endif
 
 }  // namespace omnibox_everywhere
