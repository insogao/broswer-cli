 }
 
+BrowserCliCommandLineIntent ArbitrateBrowserCliCommandLineIntent(
+    const base::CommandLine& command_line) {
+  // An assist request/release intent wins unconditionally: a command line that
+  // also carries the user-explicit show switch is denied by the assist
+  // classifier (kBlockedByConflictingSwitches) and consumed by the assist
+  // producer, so the show producer and its presentation gateway are never
+  // reached and the conflicting request can never fall back to ordinary launch
+  // processing either.
+  if (HasForegroundAssistIntent(command_line)) {
+    return BrowserCliCommandLineIntent::kForegroundAssist;
+  }
+  if (command_line.HasSwitch(kBrowserCliUserExplicitShowSwitch)) {
+    return BrowserCliCommandLineIntent::kUserExplicitShow;
+  }
+  return BrowserCliCommandLineIntent::kOrdinary;
+}
