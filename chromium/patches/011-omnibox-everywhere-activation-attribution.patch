diff --git a/chrome/browser/ui/omnibox/omnibox_everywhere/mac_window_util_unittest.cc b/chrome/browser/ui/omnibox/omnibox_everywhere/mac_window_util_unittest.cc
new file mode 100644
index 0000000000..d84b1d8568
--- /dev/null
+++ b/chrome/browser/ui/omnibox/omnibox_everywhere/mac_window_util_unittest.cc
@@ -0,0 +1,42 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/omnibox/omnibox_everywhere/mac_window_util.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace omnibox_everywhere {
+namespace {
+
+// Pure routing matrix for Browser CLI managed background presentation. These
+// tests never create a window and never touch AppKit: they pin the decision
+// that only a provable browser-process user input may route an Omnibox
+// Everywhere activation through the USER_EXPLICIT presentation gateway, while
+// unattributed requests fail closed and stock Chromium keeps its native
+// behavior.
+TEST(OmniboxEverywhereMacWindowUtilTest,
+     ManagedModeWithoutUserInputFailsClosed) {
+  EXPECT_EQ(DecideWindowActivationRoute(/*managed_mode=*/true,
+                                        /*user_gesture=*/false),
+            WindowActivationRoute::kNoop);
+}
+
+TEST(OmniboxEverywhereMacWindowUtilTest,
+     ManagedModeWithUserInputUsesExplicitGateway) {
+  EXPECT_EQ(
+      DecideWindowActivationRoute(/*managed_mode=*/true, /*user_gesture=*/true),
+      WindowActivationRoute::kExplicitGateway);
+}
+
+TEST(OmniboxEverywhereMacWindowUtilTest, StockModeKeepsDirectAppKit) {
+  EXPECT_EQ(DecideWindowActivationRoute(/*managed_mode=*/false,
+                                        /*user_gesture=*/false),
+            WindowActivationRoute::kDirectAppKit);
+  EXPECT_EQ(DecideWindowActivationRoute(/*managed_mode=*/false,
+                                        /*user_gesture=*/true),
+            WindowActivationRoute::kDirectAppKit);
+}
+
+}  // namespace
+}  // namespace omnibox_everywhere
