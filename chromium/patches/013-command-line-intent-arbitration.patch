@@ -309,5 +309,72 @@ TEST(ForegroundAssistRequestTest, SupportingSwitchesKeepRequest) {
             ForegroundAssistRequestClass::kRequestLease);
 }
 
+// ---------------------------------------------------------------------------
+// Command-line intent arbitration (patch 013). The assist producer always wins
+// over the explicit show switch, so a conflicting command line is denied by
+// the assist classifier (kBlockedByConflictingSwitches) and consumed: the show
+// producer and its presentation gateway are never reached.
+// ---------------------------------------------------------------------------
+
+TEST(BrowserCliCommandLineIntentTest, AssistRequestWinsOverShowSwitch) {
+  base::CommandLine command_line = RequestCommandLine();
+  command_line.AppendSwitch(kBrowserCliUserExplicitShowSwitch);
+  EXPECT_EQ(ArbitrateBrowserCliCommandLineIntent(command_line),
+            BrowserCliCommandLineIntent::kForegroundAssist);
+}
+
+TEST(BrowserCliCommandLineIntentTest, AssistReleaseWinsOverShowSwitch) {
+  base::CommandLine command_line = ReleaseCommandLine();
+  command_line.AppendSwitch(kBrowserCliUserExplicitShowSwitch);
+  EXPECT_EQ(ArbitrateBrowserCliCommandLineIntent(command_line),
+            BrowserCliCommandLineIntent::kForegroundAssist);
+}
+
+TEST(BrowserCliCommandLineIntentTest, AssistRequestAloneIsAssist) {
+  EXPECT_EQ(ArbitrateBrowserCliCommandLineIntent(RequestCommandLine()),
+            BrowserCliCommandLineIntent::kForegroundAssist);
+}
+
+TEST(BrowserCliCommandLineIntentTest, AssistReleaseAloneIsAssist) {
+  EXPECT_EQ(ArbitrateBrowserCliCommandLineIntent(ReleaseCommandLine()),
+            BrowserCliCommandLineIntent::kForegroundAssist);
+}
+
+TEST(BrowserCliCommandLineIntentTest, ShowAloneIsShow) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  command_line.AppendSwitch(kBrowserCliUserExplicitShowSwitch);
+  EXPECT_EQ(ArbitrateBrowserCliCommandLineIntent(command_line),
+            BrowserCliCommandLineIntent::kUserExplicitShow);
+}
+
+TEST(BrowserCliCommandLineIntentTest, OrdinaryCommandLineIsOrdinary) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  command_line.AppendArg("https://example.com/");
+  EXPECT_EQ(ArbitrateBrowserCliCommandLineIntent(command_line),
+            BrowserCliCommandLineIntent::kOrdinary);
+}
+
+TEST(BrowserCliCommandLineIntentTest,
+     AuxiliaryAssistSwitchesAloneHaveNoIntent) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  command_line.AppendSwitchASCII(kBrowserCliForegroundAssistReasonSwitch,
+                                 "login");
+  command_line.AppendSwitchASCII(kBrowserCliForegroundAssistWindowSwitch,
+                                 "42");
+  EXPECT_EQ(ArbitrateBrowserCliCommandLineIntent(command_line),
+            BrowserCliCommandLineIntent::kOrdinary);
+}
+
+TEST(BrowserCliCommandLineIntentTest,
+     ConflictingShowAndAssistIsDeniedAndConsumed) {
+  base::CommandLine command_line = RequestCommandLine();
+  command_line.AppendSwitch(kBrowserCliUserExplicitShowSwitch);
+  ForegroundAssistRequest request;
+  EXPECT_EQ(ClassifyForegroundAssistRequest(command_line, &request),
+            ForegroundAssistRequestClass::kBlockedByConflictingSwitches);
+  EXPECT_TRUE(ForegroundAssistRequestClassConsumesCommandLine(
+      ForegroundAssistRequestClass::kBlockedByConflictingSwitches));
+}
